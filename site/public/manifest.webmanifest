{
  "name": "OPTCG Data",
  "short_name": "OPTCG Data",
  "description": "OPTCG Sim ranked ladder: top players, bounties, leaders, decks and cards. Updated daily.",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0b0e14",
