  #zoom img { max-height: min(80vh, 900px); max-width: min(92vw, 640px); border-radius: 4.5% / 3.2%; box-shadow: 0 30px 80px -20px rgba(0,0,0,.9), 0 0 0 1px rgba(255,255,255,.08); transition: transform .2s, opacity .2s; }
