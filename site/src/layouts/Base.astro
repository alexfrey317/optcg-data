---
import { meta } from '../lib/data';
interface Props { title: string; description?: string; wide?: boolean }
const { title, description = 'OPTCG Sim ranked ladder: top players, bounties, leaders, decks and cards. Daily snapshot.', wide = false } = Astro.props;
const path = Astro.url.pathname;
const nav = [['/', 'Ladder'], ['/leaders/', 'Leaders'], ['/matchups/', 'Matchups'], ['/counter/', 'Counter'], ['/replays/', 'Replays']];
const active = (href: string) => (href === '/' ? path === '/' || path.startsWith('/ladder/') : path.startsWith(href) || /^\/(1d|30d|90d)/.test(path) && path.replace(/^\/(1d|30d|90d)/, '').startsWith(href));
const ICONS: Record<string, string> = {
  '/': 'M3 20h4V10H3zM10 20h4V4h-4zM17 20h4v-7h-4z',
  '/leaders/': 'M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.3 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8z',
  '/matchups/': 'M3 3h8v8H3zM13 3h8v8h-8zM3 13h8v8H3zM13 13h8v8h-8z',
  '/counter/': 'M12 2a10 10 0 100 20 10 10 0 000-20zm0 4a6 6 0 110 12 6 6 0 010-12zm0 3.5a2.5 2.5 0 100 5 2.5 2.5 0 000-5z',
  '/replays/': 'M4 4h16a1 1 0 011 1v14a1 1 0 01-1 1H4a1 1 0 01-1-1V5a1 1 0 011-1zm6 4v8l6-4z',
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} · OPTCG Data</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} · OPTCG Data`} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#0b0e14" />
    <meta name="color-scheme" content="dark" />
    <meta name="application-name" content="OPTCG Data" />
    <meta name="apple-mobile-web-app-title" content="OPTCG Data" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="icon" href="/icons/icon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://static.dotgg.gg" />
  </head>
  <body>
    <header class="top">
      <div class:list={['wrap', { wide }]}>
        <a class="brand" href="/"><span class="coin">฿</span> OPTCG <b>Data</b></a>
        <nav>{nav.map(([href, label]) => <a href={href} class:list={{ active: active(href) }}>{label}</a>)}</nav>
        <span class="snap" title={`Generated ${meta.generatedAt}`}><span class="snap-l">Last updated </span><b>{meta.date || '–'}</b></span>
        <button type="button" id="install" class="copy" hidden title="Install OPTCG Data as an app">Install</button>
      </div>
    </header>
    <main class:list={['wrap', { wide }]}><slot /></main>
    <nav class="tabbar" aria-label="Sections">
      {nav.map(([href, label]) => <a href={href} class:list={{ active: active(href) }} aria-current={active(href) ? 'page' : undefined}><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d={ICONS[href]} fill="currentColor" /></svg><span>{label}</span></a>)}
    </nav>
    <button type="button" id="totop" aria-label="Back to top" hidden><svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path d="M3 10l5-5 5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    <div id="tip" role="tooltip"></div>
    <div id="sheet" role="dialog" aria-modal="false" aria-labelledby="sheet-title" hidden><div class="sheet-grip"></div><div class="sheet-head"><b id="sheet-title"></b><button type="button" class="sheet-close" aria-label="Close">✕</button></div><p id="sheet-text"></p><div class="sheet-hint">Drag across other column headers to read them · swipe down to close</div></div>
    <div id="zoom" role="dialog" aria-modal="true" aria-label="Card preview" hidden><figure><img alt="" /><figcaption></figcaption><div class="zoom-hint">Swipe for the next card · swipe down or tap to close</div></figure></div>
    <script>
      // one delegated handler instead of an inline onerror on every image: promos are missing upstream
      document.addEventListener('error', (e) => { const el = e.target as HTMLElement; if (el instanceof HTMLImageElement) { el.style.visibility = 'hidden'; el.parentElement?.classList.add('noimg'); } }, true);
      const tip = document.getElementById('tip')!;
      let current: HTMLElement | null = null;
      function show(el: HTMLElement) {
        current = el; el.classList.add('on');
        tip.textContent = el.dataset.tip ?? ''; el.removeAttribute('title');
        tip.classList.add('show');
        const r = el.getBoundingClientRect(), tw = tip.offsetWidth, th = tip.offsetHeight;
        let x = r.left + r.width / 2 - tw / 2, y = r.top - th - 8;
        if (y < 8) y = r.bottom + 8;
        x = Math.max(8, Math.min(x, window.innerWidth - tw - 8));
        tip.style.left = `${x}px`; tip.style.top = `${y}px`;
      }
      function hide() { tip.classList.remove('show'); current?.classList.remove('on'); current = null; }
      const coarse = matchMedia('(pointer: coarse)').matches || location.hash === '#touch'; // hash = manual testing on desktop
      document.addEventListener('mouseover', (e) => { if (coarse) return; const el = (e.target as HTMLElement).closest<HTMLElement>('.info'); if (el && el !== current) show(el); else if (!el && current) hide(); });
      document.addEventListener('focusin', (e) => { if (coarse) return; const el = (e.target as HTMLElement).closest<HTMLElement>('.info'); if (el) show(el); });
      document.addEventListener('focusout', hide);
      document.addEventListener('click', (e) => { if (coarse) return; const el = (e.target as HTMLElement).closest<HTMLElement>('.info'); if (el) { e.preventDefault(); e.stopPropagation(); current === el && tip.classList.contains('show') ? hide() : show(el); } else if (current) hide(); });
      document.addEventListener('scroll', hide, { passive: true });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') hide(); });

      // Touch devices: explanations open in a bottom sheet instead of a tooltip. Tap the ⓘ or its whole label;
      // long-press a sortable header to read it without sorting; drag across headers to move between them.
      const sheet = document.getElementById('sheet')!, sheetTitle = document.getElementById('sheet-title')!, sheetText = document.getElementById('sheet-text')!;
      const HOLDER = 'th, .label, h2, .sort-opt, .stat, summary, label';
      const infoOf = (t: Element | null): HTMLElement | null => {
        if (!t) return null;
        const direct = t.closest<HTMLElement>('.info'); if (direct) return direct;
        const holder = t.closest<HTMLElement>(HOLDER); if (!holder) return null;
        const infos = holder.querySelectorAll<HTMLElement>('.info'); return infos.length === 1 ? infos[0] : null;
      };
      const titleOf = (info: HTMLElement) => {
        const holder = info.closest<HTMLElement>(HOLDER);
        if (!holder) return 'About this number';
        const clone = holder.cloneNode(true) as HTMLElement; clone.querySelectorAll('.info, .sub, .wtoggle, .value, .sort-btn:not(.on)').forEach((n) => n.remove());
        return (clone.textContent ?? '').replace(/\s+/g, ' ').trim().slice(0, 60) || 'About this number';
      };
      let sheetFor: HTMLElement | null = null;
      const openSheet = (info: HTMLElement) => {
        sheetFor = info; sheetTitle.textContent = titleOf(info); sheetText.textContent = info.dataset.tip ?? info.getAttribute('aria-label') ?? '';
        document.querySelectorAll('.info.on').forEach((x) => x.classList.remove('on')); info.classList.add('on');
        sheet.hidden = false;
      };
      const closeSheet = () => { sheet.hidden = true; sheetFor?.classList.remove('on'); sheetFor = null; };
      sheet.querySelector('.sheet-close')!.addEventListener('click', closeSheet);
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeSheet(); });
      if (coarse) {
        let pressTimer = 0, pressInfo: HTMLElement | null = null, dragging = false, moved = false, sx = 0, sy = 0;
        document.addEventListener('touchstart', (e) => {
          const t = e.touches[0]; sx = t.clientX; sy = t.clientY; moved = false; dragging = false;
          if (sheet.contains(e.target as Node)) return;
          pressInfo = infoOf(e.target as Element);
          if (!pressInfo) { if (!sheet.hidden && !(e.target as Element).closest('.info')) closeSheet(); return; }
          clearTimeout(pressTimer);
          pressTimer = window.setTimeout(() => { if (!moved && pressInfo) { openSheet(pressInfo); dragging = true; if (navigator.vibrate) navigator.vibrate(8); } }, 380);
        }, { passive: true });
        document.addEventListener('touchmove', (e) => {
          const t = e.touches[0];
          if (!dragging) { if (Math.abs(t.clientX - sx) > 8 || Math.abs(t.clientY - sy) > 8) { moved = true; clearTimeout(pressTimer); } return; }
          const under = infoOf(document.elementFromPoint(t.clientX, t.clientY));
          if (under && under !== sheetFor) openSheet(under);
        }, { passive: true });
        document.addEventListener('touchend', () => { clearTimeout(pressTimer); dragging = false; }, { passive: true });
        document.addEventListener('touchcancel', () => { clearTimeout(pressTimer); dragging = false; }, { passive: true });
        // plain tap: the ⓘ itself, or any non-sortable label that holds exactly one ⓘ (sortable headers keep tap = sort)
        document.addEventListener('click', (e) => {
          const target = e.target as Element;
          if (sheet.contains(target)) return;
          const direct = target.closest<HTMLElement>('.info');
          const info = direct ?? infoOf(target);
          if (!info) return;
          if (!direct && target.closest('th.sortable, summary, a, button')) return;
          e.preventDefault(); e.stopPropagation();
          info === sheetFor && !sheet.hidden ? closeSheet() : openSheet(info);
        }, true);
        // swipe the sheet down to dismiss
        let shy = 0;
        sheet.addEventListener('touchstart', (e) => { shy = e.touches[0].clientY; }, { passive: true });
        sheet.addEventListener('touchmove', (e) => { const dy = e.touches[0].clientY - shy; sheet.style.transform = `translateY(${Math.max(0, dy)}px)`; }, { passive: true });
        sheet.addEventListener('touchend', (e) => { const dy = e.changedTouches[0].clientY - shy; sheet.style.transform = ''; if (dy > 60) closeSheet(); });
      }

      // Card zoom: tap any card image that is not already a link to see it large. Swipe left/right moves through the
      // other cards of the same list; swipe down, tap, Escape or the back button closes.
      const zoom = document.getElementById('zoom')!, zimg = zoom.querySelector('img')!, zcap = zoom.querySelector('figcaption')!;
      let zoomList: HTMLImageElement[] = [], zoomIdx = 0, zoomPushed = false;
      const isCardImg = (el: Element | null): el is HTMLImageElement => el instanceof HTMLImageElement && el.src.includes('static.dotgg.gg');
      const showZoom = (img: HTMLImageElement) => {
        const holder = img.closest<HTMLElement>('[title]');
        zimg.src = img.currentSrc || img.src; zcap.textContent = img.alt || holder?.title || '';
        zoom.classList.toggle('multi', zoomList.length > 1);
      };
      const closeZoom = (fromHistory = false) => {
        if (zoom.hidden) return;
        zoom.hidden = true; zimg.removeAttribute('src'); document.body.style.overflow = ''; zimg.style.transform = ''; zimg.style.opacity = '';
        if (zoomPushed && !fromHistory) history.back();
        zoomPushed = false;
      };
      const step = (d: number) => { if (zoomList.length < 2) return; zoomIdx = (zoomIdx + d + zoomList.length) % zoomList.length; showZoom(zoomList[zoomIdx]); };
      document.addEventListener('click', (e) => {
        const img = (e.target as HTMLElement).closest<HTMLImageElement>('img[src*="static.dotgg.gg"]');
        if (!img || img.closest('a')) return;
        e.preventDefault();
        const group = img.closest('.cards, .hand-row, .deck-preview');
        zoomList = group ? [...group.querySelectorAll('img')].filter(isCardImg) : [img];
        zoomIdx = Math.max(0, zoomList.indexOf(img));
        showZoom(img);
        zoom.hidden = false; document.body.style.overflow = 'hidden';
        history.pushState({ zoom: true }, ''); zoomPushed = true;
      });
      zoom.addEventListener('click', () => closeZoom());
      window.addEventListener('popstate', () => closeZoom(true));
      document.addEventListener('keydown', (e) => { if (zoom.hidden) return; if (e.key === 'Escape') closeZoom(); else if (e.key === 'ArrowRight') step(1); else if (e.key === 'ArrowLeft') step(-1); });
      let tx = 0, ty = 0, tt = 0, dragging = false;
      zoom.addEventListener('touchstart', (e) => { const t = e.touches[0]; tx = t.clientX; ty = t.clientY; tt = Date.now(); dragging = true; zimg.style.transition = 'none'; }, { passive: true });
      zoom.addEventListener('touchmove', (e) => {
        if (!dragging) return; const t = e.touches[0]; const dx = t.clientX - tx, dy = t.clientY - ty;
        zimg.style.transform = `translate(${dx}px, ${Math.max(0, dy)}px)`; zimg.style.opacity = String(Math.max(.35, 1 - Math.max(0, dy) / 400));
      }, { passive: true });
      zoom.addEventListener('touchend', (e) => {
        if (!dragging) return; dragging = false; const t = e.changedTouches[0]; const dx = t.clientX - tx, dy = t.clientY - ty, fast = Date.now() - tt < 350;
        zimg.style.transition = ''; zimg.style.transform = ''; zimg.style.opacity = '';
        if (dy > 90 || (fast && dy > 40 && Math.abs(dx) < 60)) { closeZoom(); return; }
        if (Math.abs(dx) > 60 && Math.abs(dx) > Math.abs(dy)) { step(dx < 0 ? 1 : -1); zoom.setAttribute('data-swiped', '1'); setTimeout(() => zoom.removeAttribute('data-swiped'), 400); }
      });
      zoom.addEventListener('click', (e) => { if (zoom.getAttribute('data-swiped')) { e.stopImmediatePropagation(); } }, true);

      // Deck lists: "Show more" keeps the first data-limit lists visible; the sort bar reorders by a data-* key and renumbers.
      // A card filter (set from the Card Usage table or the filter select on leader pages) keeps only lists running that card.
      document.querySelectorAll<HTMLElement>('.decklist').forEach((box) => {
        const limit = Number(box.dataset.limit ?? 5), noun = box.dataset.noun ?? 'lists';
        let items = [...box.querySelectorAll<HTMLElement>(':scope > details.deck')];
        const btn = box.querySelector<HTMLButtonElement>(':scope > .show-more');
        const chip = box.querySelector<HTMLElement>(':scope > .deck-filter');
        let open = false, filter = '';
        const visible = () => (filter ? items.filter((d) => (d.dataset.cards ?? '').split(' ').some((c) => c.startsWith(filter + ':'))) : items);
        const render = () => {
          const vis = visible(); const hid = new Set(items); vis.forEach((d) => hid.delete(d));
          hid.forEach((d) => { d.hidden = true; });
          vis.forEach((d, i) => { d.hidden = !open && i >= limit; const r = d.querySelector('.deck-rank'); if (r) r.textContent = String(i + 1); });
          if (btn) { btn.hidden = vis.length <= limit; btn.textContent = open ? `Show fewer ${noun}` : `Show ${vis.length - limit} more ${noun}`; }
          if (chip) { chip.hidden = !filter; const n = chip.querySelector('.deck-filter-n'); if (n) n.textContent = `${vis.length} of ${items.length} ${noun}`; }
          box.classList.toggle('filtered', !!filter);
        };
        (box as any).setCardFilter = (id: string, name?: string) => {
          filter = id || ''; open = false;
          const nm = chip?.querySelector('.deck-filter-name'); if (nm) nm.textContent = name || id;
          box.querySelectorAll<HTMLSelectElement>('.deck-filter-select').forEach((s) => { s.value = filter; });
          render();
          if (filter) box.scrollIntoView({ block: 'start', behavior: 'smooth' });
        };
        chip?.querySelector('.deck-filter-clear')?.addEventListener('click', () => (box as any).setCardFilter(''));
        box.querySelectorAll<HTMLSelectElement>('.deck-filter-select').forEach((s) => s.addEventListener('change', () => (box as any).setCardFilter(s.value, s.selectedOptions[0]?.textContent ?? s.value)));
        btn?.addEventListener('click', () => { open = !open; render(); if (!open) box.scrollIntoView({ block: 'nearest' }); });
        box.querySelectorAll<HTMLButtonElement>('.sort-btn').forEach((sb) => sb.addEventListener('click', () => {
          const key = sb.dataset.sort!;
          box.querySelectorAll('.sort-btn').forEach((x) => x.classList.remove('on')); sb.classList.add('on');
          items.sort((a, b) => Number(b.dataset[key] ?? 0) - Number(a.dataset[key] ?? 0) || Number(b.dataset.games ?? 0) - Number(a.dataset.games ?? 0));
          const anchor = btn ?? null;
          items.forEach((d, i) => { d.open = i === 0; anchor ? box.insertBefore(d, anchor) : box.appendChild(d); });
          render();
        }));
        render();
      });
      // Card Usage rows (and mirror / hand cards) carry data-filter-card: clicking one filters the page's main decklist.
      document.addEventListener('click', (e) => {
        const t = e.target as HTMLElement;
        if (t.closest('a, button, .info')) return;
        const row = t.closest<HTMLElement>('[data-filter-card]'); if (!row) return;
        const box = document.querySelector<HTMLElement>('.decklist[data-filterable]'); if (!box) return;
        const id = row.dataset.filterCard!, name = row.dataset.filterName || id;
        (box as any).setCardFilter(box.classList.contains('filtered') && box.querySelector('.deck-filter-name')?.textContent === name ? '' : id, name);
      });

      // Copy buttons: clipboard with a fallback for older mobile browsers (execCommand on a temporary textarea).
      document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button.copy[data-copy]');
        if (!btn) return;
        e.preventDefault();
        const text = btn.dataset.copy ?? '';
        const done = () => { const prev = btn.textContent; btn.textContent = 'Copied'; setTimeout(() => { btn.textContent = prev; }, 1200); };
        const fallback = () => { const ta = document.createElement('textarea'); ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0'; document.body.appendChild(ta); ta.select(); try { document.execCommand('copy'); } finally { ta.remove(); } done(); };
        navigator.clipboard?.writeText(text).then(done, fallback) ?? fallback();
      });

      // Back to top after a long scroll (mobile pages get long).
      const totop = document.getElementById('totop') as HTMLButtonElement;
      const onScroll = () => { totop.hidden = window.scrollY < 900; };
      window.addEventListener('scroll', onScroll, { passive: true }); onScroll();
      totop.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));

      // Progressive web app: service worker + install button (only when the browser offers an install prompt).
      if ('serviceWorker' in navigator && location.protocol === 'https:') {
        window.addEventListener('load', () => { navigator.serviceWorker.register('/sw.js').catch(() => {}); });
      }
      let installEvt: any = null;
      const installBtn = document.getElementById('install') as HTMLButtonElement;
      window.addEventListener('beforeinstallprompt', (e) => { e.preventDefault(); installEvt = e; installBtn.hidden = false; });
      installBtn.addEventListener('click', async () => { if (!installEvt) return; installEvt.prompt(); await installEvt.userChoice; installEvt = null; installBtn.hidden = true; });
      window.addEventListener('appinstalled', () => { installBtn.hidden = true; });
    </script>
    <footer class:list={['wrap', { wide }]}>
      <div>Standard ranked data, refreshed once a day.</div>
      <div>Unofficial fan project. One Piece Card Game is a trademark of Bandai. Not affiliated with Bandai or OPTCG Sim.</div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #0b0e14; --bg-2: #10141c; --panel: #151a24; --panel-2: #1b2130; --line: #262d3d; --line-2: #313a4e;
    --text: #e9ecf3; --muted: #97a0b6; --dim: #6b7389;
    --accent: #e8c04a; --accent-2: #f3d97c; --good: #4fd18f; --bad: #ef5a60; --link: #8fbcff;
    --shadow: 0 1px 0 rgba(255,255,255,.03) inset, 0 8px 24px -16px rgba(0,0,0,.8);
    --r: 12px;
    --sat: env(safe-area-inset-top, 0px); --sab: env(safe-area-inset-bottom, 0px); --sal: env(safe-area-inset-left, 0px); --sar: env(safe-area-inset-right, 0px);
    --head-h: calc(56px + var(--sat));
    font-family: "Inter", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; color-scheme: dark;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } *, *::before, *::after { transition: none !important; animation: none !important; } }
  body { margin: 0; background: radial-gradient(1200px 500px at 20% -10%, #1a2033 0%, transparent 60%), radial-gradient(900px 400px at 100% 0%, #2a2410 0%, transparent 55%), var(--bg); color: var(--text); line-height: 1.45; -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: transparent; overscroll-behavior-y: none; }
  a { color: var(--link); text-decoration: none; } a:hover { text-decoration: underline; text-underline-offset: 2px; }
  .wrap { max-width: 1240px; margin: 0 auto; padding: 0 max(1.25rem, var(--sal)) 0 max(1.25rem, var(--sar)); } .wrap.wide { max-width: 1560px; }
  main.wrap { padding-top: 1.5rem; padding-bottom: 4rem; }

  header.top { border-bottom: 1px solid var(--line); background: rgba(11,14,20,.75); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); position: sticky; top: 0; z-index: 20; padding-top: var(--sat); }
  header.top .wrap { display: flex; align-items: center; gap: 2rem; height: 56px; }
  .brand { color: var(--text); font-weight: 600; letter-spacing: .01em; display: inline-flex; align-items: center; gap: .5rem; font-size: 1.05rem; white-space: nowrap; } .brand b { color: var(--accent); font-weight: 800; }
  .coin { display: inline-grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: linear-gradient(160deg, var(--accent-2), #b8901f); color: #1a1405; font-weight: 900; font-size: .9rem; box-shadow: 0 0 0 2px rgba(232,192,74,.25); }
  header nav { display: flex; gap: .25rem; } header nav a { color: var(--muted); padding: .35rem .75rem; border-radius: 8px; font-weight: 500; }
  header nav a:hover { color: var(--text); background: var(--panel-2); text-decoration: none; } header nav a.active { color: var(--text); background: var(--panel-2); box-shadow: inset 0 -2px 0 var(--accent); }
  .snap { margin-left: auto; color: var(--muted); font-size: .85rem; font-variant-numeric: tabular-nums; white-space: nowrap; } .snap b { color: var(--text); font-weight: 600; }
  #install { flex: none; }
  footer.wrap { padding: 1.25rem; color: var(--dim); font-size: .8rem; border-top: 1px solid var(--line); display: grid; gap: .25rem; }

  /* mobile bottom tab bar (replaces the header nav on narrow screens) */
  .tabbar { display: none; }
  @media (max-width: 860px) {
    header nav { display: none; }
    header.top .wrap { gap: 1rem; }
    .snap-l { display: none; }
    .tabbar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 30; display: grid; grid-template-columns: repeat(5, 1fr); background: rgba(11,14,20,.92); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-top: 1px solid var(--line); padding: .3rem max(.25rem, var(--sar)) calc(.3rem + var(--sab)) max(.25rem, var(--sal)); }
    .tabbar a { display: grid; justify-items: center; gap: .15rem; padding: .35rem 0; color: var(--dim); font-size: .68rem; font-weight: 600; letter-spacing: .02em; border-radius: 10px; min-height: 48px; }
    .tabbar a:hover { text-decoration: none; } .tabbar a.active { color: var(--accent); }
    .tabbar a:active { background: var(--panel-2); }
    main.wrap { padding-bottom: calc(5.25rem + var(--sab)); }
    footer.wrap { padding-bottom: calc(5rem + var(--sab)); }
