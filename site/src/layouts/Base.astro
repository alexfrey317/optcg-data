  .hand-card { flex: none; width: 104px; scroll-snap-align: start; } .hand-card img { width: 100%; aspect-ratio: 5/7; object-fit: cover; border-radius: 7px; display: block; box-shadow: 0 6px 14px -8px rgba(0,0,0,.9); margin-bottom: .3rem; }
  /* full matrix */
