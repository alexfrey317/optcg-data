  .card img, .card .blank { width: 100%; aspect-ratio: 5/7; object-fit: cover; border-radius: 7px; background: var(--panel-2); display: block; box-shadow: 0 6px 14px -8px rgba(0,0,0,.9); }
  .card .blank { display: grid; place-items: center; color: var(--dim); font-size: .7rem; text-align: center; padding: .4rem; }
  .card .qty { position: absolute; top: 6px; left: 6px; background: rgba(0,0,0,.8); color: #fff; font-weight: 800; font-size: .85rem; padding: .05rem .4rem; border-radius: 6px; box-shadow: 0 0 0 1px rgba(255,255,255,.15); }
  .card .cname { font-size: .72rem; color: var(--muted); margin-top: .3rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-align: center; }
  .src { font-size: .7rem; padding: .05rem .45rem; border-radius: 999px; border: 1px solid var(--line-2); color: var(--muted); margin-right: .3rem; font-weight: 600; letter-spacing: .01em; }
  .src.opbounty { border-color: #8fbcff55; color: #8fbcff; } .src.kaizokuBest, .src.kaizokuPlayed { border-color: #e8c04a55; color: var(--accent); } .src.optcgone { border-color: #4fd18f55; color: var(--good); }
  .copy { background: var(--panel-2); color: var(--text); border: 1px solid var(--line-2); border-radius: 8px; padding: .35rem .7rem; cursor: pointer; font-size: .8rem; font-family: inherit; min-height: 32px; } .copy:hover { border-color: var(--accent); color: var(--accent-2); }
  .spark { display: block; }
