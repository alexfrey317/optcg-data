  @media (max-width: 1400px) { .panel.scroll.matrix-wrap { overflow: auto; max-height: calc(100dvh - var(--head-h) - 1rem); } .matrix thead th { top: 0; } }
  .matrix td { min-width: 66px; font-variant-numeric: tabular-nums; border-radius: 6px; } .matrix td.self { background: var(--panel-2); }
  .matrix .leader-frame { margin: 0 auto; }
  code, pre { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .85em; }
  pre { background: var(--panel-2); padding: .8rem; border-radius: 8px; overflow: auto; }

  /* ladder table → stacked player cards on phones (thead hidden; the mobile sort select replaces column sorting) */
  @media (max-width: 720px) {
    .m-only { display: initial; }
    .hide-m { display: none !important; }
    .wrap { padding-left: max(.85rem, var(--sal)); padding-right: max(.85rem, var(--sar)); }
    main.wrap { padding-top: 1rem; }
    h1 { font-size: 1.45rem; } h2 { margin-top: 1.5rem; }
    .hero { flex-direction: column; align-items: stretch; gap: 1rem; padding: 1rem; }
    .hero .leader-xl { align-self: center; } .leader-xl .leader-frame { width: 132px; height: 185px; }
