---
interface Props { points: number[]; width?: number; height?: number; stroke?: string }
const { points, width = 120, height = 28, stroke = 'var(--accent)' } = Astro.props;
const n = points.length;
let d = '';
if (n >= 2) {
  const min = Math.min(...points), max = Math.max(...points);
  const span = max - min || 1;
  d = points.map((p, i) => `${i === 0 ? 'M' : 'L'}${((i / (n - 1)) * (width - 2) + 1).toFixed(1)},${(height - 2 - ((p - min) / span) * (height - 4) + 1).toFixed(1)}`).join(' ');
}
const up = n >= 2 && points[n - 1] >= points[0];
---
{n >= 2 ? (
  <svg class="spark" width={width} height={height} viewBox={`0 0 ${width} ${height}`} aria-label={`${n} day trend`}>
    <path d={d} fill="none" stroke={up ? stroke : 'var(--bad)'} stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round" />
  </svg>
) : <span class="muted" style="font-size:.75rem">1 day</span>}
