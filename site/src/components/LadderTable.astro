---
import LeaderArt from './LeaderArt.astro';
import Info from './Info.astro';
import { seasonRecord, playerById, fmt, pct, berry, flag, type Player, type Win } from '../lib/data';
/** Ladder rows. On phones the table becomes stacked player cards (see `.ladder` rules in Base.astro); the
 *  `c-*` classes place each cell in that grid. `sortable` wires header sorting (the page script does the work). */
interface Props { rows: Player[]; id?: string; sortable?: boolean; win?: Win }
const { rows, id, sortable = false, win = '7d' } = Astro.props;
// spoiler-queue rows: ladder record only (profiles are Standard), leaders link into the spoiler window, player pages only for Standard-ranked players
const sp = win === 'spoiler';
const playerHref = (p: Player) => (p.id == null || (sp && !playerById.has(String(p.id))) ? undefined : `/players/${p.id}/`);
---
<table id={id} class="ladder">
  <thead><tr>
    <th class:list={['num', { 'sortable sorted': sortable }]} data-k="rank">#</th>
    <th>Player</th>
    <th class:list={['num', { sortable }]} data-k="bounty">Bounty <Info text="Ranked rating. Higher is better. Roughly 1,500 for a new account; the top players sit above 4,000." /></th>
    <th class:list={['num', { sortable }]} data-k="matches">Games <Info text={sp ? 'Ranked games in the spoiler queue this season, with the win–loss record underneath.' : 'Ranked games with the win–loss record underneath. OPBounty resets the ladder each season; our count keeps adding across seasons.'} /></th>
    <th class:list={['num', { sortable }]} data-k="winrate">Win % <Info text="Wins divided by ranked games played." /></th>
    <th>Top Leaders <Info text="The three leaders this player has played most, with their personal win rate and game count on each." /></th>
  </tr></thead>
  <tbody>
    {rows.map((p) => { const r = seasonRecord(p, sp); return (
      <tr class:list={{ top1: p.rank === 1, top3: p.rank > 1 && p.rank <= 3 }} data-name={p.name.toLowerCase()} data-country={p.country ?? ''} data-leaders={p.topLeaders.map((t) => t.code).join(' ')}
          data-rank={p.rank} data-bounty={p.bounty} data-matches={r.games} data-winrate={r.winRate ?? 0}>
        <td class="num c-rank"><span class="pill-rank">{p.rank}</span></td>
        <td class="c-name"><a href={playerHref(p)} style="font-weight:600;color:var(--text)">{p.name}</a>
          {p.country && <div class="muted small">{flag(p.country)} {p.country}</div>}</td>
        <td class="num gold c-bounty" style="font-weight:700;font-size:1.02rem">{berry(p.bounty)}</td>
        <td class="num c-games">{r.games ? <>{fmt(r.games, 0)}<div class="muted small">{r.wins}–{r.losses}</div></> : <span class="dim">–</span>}</td>
        <td class:list={['num', 'c-wr', (r.winRate ?? 0) >= 50 ? 'good' : 'bad']} style="font-weight:600">{r.games ? pct(r.winRate) : <span class="dim">–</span>}</td>
        <td class="c-leaders"><div class="leader-row">{p.topLeaders.slice(0, 3).map((t) => <LeaderArt code={t.code} size="sm" sub={`${fmt(t.winRate)}% · ${t.matches} games`} href={sp ? `/spoiler/leaders/${t.code}/` : undefined} />)}</div></td>
      </tr>); })}
  </tbody>
</table>
