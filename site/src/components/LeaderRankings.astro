---
import Info from './Info.astro';
import WindowToggle from './WindowToggle.astro';
import { leadersByVolumeFor, fmt, pct, players, leaderStats, imgUrl, imgOnError, colorVar, leaderHistory, windowMeta, wpath, cardFileFor, WINDOWS, MIN_PLAY_RATE, type Win } from '../lib/data';
interface Props { window: Win }
const { window: W } = Astro.props;
const all = leadersByVolumeFor(W).map((l) => ({ l, s: leaderStats(l), pilots: cardFileFor(W, l.code).leaderStats?.uniquePilots ?? null }));
all.sort((a, b) => (b.s.weighted ?? b.s.winRate ?? 0) - (a.s.weighted ?? a.s.winRate ?? 0));
// leaders under MIN_PLAY_RATE of games are listed after the contenders: their win rates are noise at that volume
const rows = all.filter((r) => (r.s.playRate ?? 0) >= MIN_PLAY_RATE);
const rare = all.filter((r) => (r.s.playRate ?? 0) < MIN_PLAY_RATE);
const pilots = new Map<string, number>();
for (const p of players.slice(0, 1000)) for (const t of p.topLeaders) pilots.set(t.code, (pilots.get(t.code) ?? 0) + 1);
const wm = windowMeta(W);
const totalGames = wm?.matches ?? 0;
const prevRank = new Map<string, number>();
if (W === '7d') {
  const prev = rows.map((r) => ({ code: r.l.code, h: leaderHistory(r.l.code) })).filter((x) => x.h.length >= 2)
    .map((x) => ({ code: x.code, wr: Number(x.h.at(-2)![1] ?? 0) })).sort((a, b) => b.wr - a.wr);
  prev.forEach((x, i) => prevRank.set(x.code, i + 1));
}
---
<div class="hero"><div style="flex:1"><h1>Leader Rankings</h1>
  <div class="meta">Standard ranked, {WINDOWS[W].label.toLowerCase()}. <b style="color:var(--text)">{fmt(totalGames, 0)}</b> games played. Sorted by weighted win rate; click any column to re-sort. Leaders in under {MIN_PLAY_RATE}% of games are listed separately at the bottom.</div>
  <WindowToggle current={W} path="/leaders/" /></div></div>
<div class="panel scroll">
  <table id="t" class="rank-table">
    <thead><tr>
      <th class="num c-rank">Rank</th>
      {W === '7d' && <th class="num hide-m">Δ 1D <Info text="Rank change since yesterday's snapshot." /></th>}
      <th class="hide-m">Card</th>
      <th class="c-leader">Leader</th>
      <th class="num sortable sorted" data-k="wtd">Wtd WR <Info text="Conservative win rate: the lowest win rate we can be 99% confident the leader really has, given its sample. A leader with 5,000 games loses about 1.6 points from its raw rate; one with 50,000 games loses about half a point; one with 200 games loses eight. So a 52% leader on few games can rank below a 51.5% leader on many, which is the point. Card Kaizoku instead shrinks toward the average leader's win rate (about 37%), which produces a similar order but lower numbers." /></th>
      <th class="num sortable hide-m" data-k="wr">Raw WR <Info text="Wins divided by games, unadjusted." /></th>
      <th class="num sortable" data-k="play">Play Rate <Info text="Share of all decks in the window's ranked games that were this leader. Every game has two decks, so the column sums to 100%." /></th>
      <th class="num sortable" data-k="games">Games</th>
      <th class="num sortable hide-m" data-k="pilots">Pilots <Info text="Distinct sim accounts that played this leader last week, across the whole sim (Card Kaizoku). Weekly figure regardless of the window." /></th>
      <th class="num sortable" data-k="first">1st WR <Info text="Win rate when this leader took the first turn." /></th>
      <th class="num sortable" data-k="second">2nd WR <Info text="Win rate when this leader took the second turn." /></th>
      <th class="num sortable hide-m" data-k="top">Top-1000 <Info text="How many of the top 1,000 ladder players have this leader among their three most-played." /></th>
    </tr></thead>
    <tbody>{[...rows, ...rare].map(({ l, s, pilots: up }, i) => { const pr = prevRank.get(l.code); const d = pr == null ? null : pr - (i + 1); const isRare = i >= rows.length; return (<>
      {i === rows.length && <tr class="divider"><td colspan="12"><span>Rarely played</span> <span class="muted small">under {MIN_PLAY_RATE}% of games in the window · win rates here are small samples</span></td></tr>}
      <tr class:list={{ rare: isRare }} data-rare={isRare ? '1' : '0'} data-wtd={s.weighted ?? 0} data-wr={s.winRate ?? 0} data-play={s.playRate ?? 0} data-games={s.games} data-pilots={up ?? 0} data-first={s.first ?? 0} data-second={s.second ?? 0} data-top={pilots.get(l.code) ?? 0}>
        <td class="num c-rank"><span class="pill-rank">{i + 1}</span></td>
        {W === '7d' && <td class:list={['num', 'delta', 'hide-m', d == null || d === 0 ? 'dim' : d > 0 ? 'good' : 'bad']}>{d == null || d === 0 ? '—' : d > 0 ? `↑${d}` : `↓${-d}`}</td>}
        <td class="hide-m"><a href={wpath(W, `/leaders/${l.code}/`)} class="art-wide" style={`--lc:${colorVar(l.color)}`}><img src={imgUrl(l.code)} alt="" loading="lazy" onerror={imgOnError(l.code)} /></a></td>
        <td class="c-leader"><a href={wpath(W, `/leaders/${l.code}/`)} class="leader-link"><span class="lcode muted">[{l.code}]{W === '7d' && d != null && d !== 0 && <span class:list={['m-only', d > 0 ? 'good' : 'bad']} style="margin-left:.4rem;font-weight:600">{d > 0 ? `↑${d}` : `↓${-d}`}</span>}</span> <span class="lname">{l.name}</span></a></td>
        <td class:list={['num', (s.weighted ?? 0) >= 50 ? 'good' : 'bad']} style="font-weight:700">{pct(s.weighted)}</td>
        <td class:list={['num', 'hide-m', (s.winRate ?? 0) >= 50 ? 'good' : 'bad']}>{pct(s.winRate)}</td>
        <td class="num">{pct(s.playRate)}</td>
        <td class="num muted">{fmt(s.games, 0)}</td>
        <td class="num muted hide-m">{up == null ? '–' : fmt(up, 0)}</td>
        <td class:list={['num', (s.first ?? 0) >= 50 ? 'good' : 'bad']}>{pct(s.first)}</td>
        <td class:list={['num', (s.second ?? 0) >= 50 ? 'good' : 'bad']}>{pct(s.second)}</td>
        <td class="num hide-m">{pilots.get(l.code) ?? 0}</td>
      </tr></>); })}</tbody>
  </table>
</div>
<script>
  // contenders and rarely played leaders sort independently; the divider row stays between them and ranks renumber
  const tbody = document.querySelector('#t tbody')!; const rows = [...tbody.querySelectorAll('tr[data-rare]')] as HTMLElement[];
  const divider = tbody.querySelector('tr.divider');
  let key = 'wtd', asc = false;
  document.querySelectorAll('th.sortable').forEach((th) => th.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('.info')) return;
    const k = (th as HTMLElement).dataset.k!; if (key === k) asc = !asc; else { key = k; asc = false; }
    document.querySelectorAll('th.sortable').forEach((t) => t.classList.remove('sorted', 'asc')); th.classList.add('sorted'); if (asc) th.classList.add('asc');
    rows.sort((a, b) => Number(a.dataset.rare) - Number(b.dataset.rare) || (Number(a.dataset[key]) - Number(b.dataset[key])) * (asc ? 1 : -1));
    const main = rows.filter((r) => r.dataset.rare === '0'), rare = rows.filter((r) => r.dataset.rare === '1');
    tbody.append(...main); if (divider) tbody.append(divider); tbody.append(...rare);
    rows.forEach((r, i) => { const p = r.querySelector('.pill-rank'); if (p) p.textContent = String(i + 1); });
  }));
</script>
