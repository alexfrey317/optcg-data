---
/** Small ⓘ. The tooltip text lives in data-tip and is rendered by the page-level tooltip script in Base.astro,
 *  so it is never clipped by scrolling tables. `title` is kept as a no-JS fallback. */
interface Props { text: string }
const { text } = Astro.props;
---
<button type="button" class="info" data-tip={text} title={text} aria-label={text}>
  <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="7" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M8 7v4.2M8 4.6v.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
</button>
