---
/** Small ⓘ with a hover/focus tooltip. `text` is also set as `title` so it works inside scrolling tables. */
interface Props { text: string }
const { text } = Astro.props;
---
<span class="info" tabindex="0" role="note" aria-label={text} title={text}>
  <svg width="13" height="13" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="7" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M8 7v4.2M8 4.6v.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
  <span class="tip">{text}</span>
</span>
