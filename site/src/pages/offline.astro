---
import Base from '../layouts/Base.astro';
---
<Base title="Offline">
  <div class="hero"><div>
    <h1>You're offline</h1>
    <div class="meta">This page has not been saved on your device yet. Pages you have opened before are still available from the tabs below, and everything refreshes automatically once you are back online.</div>
    <p style="margin:1rem 0 0"><a class="copy" href="/" style="display:inline-flex;align-items:center;min-height:40px">← Back to the ladder</a> <button type="button" class="copy" style="min-height:40px" onclick="location.reload()">Try again</button></p>
  </div></div>
</Base>
