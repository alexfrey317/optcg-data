---
import Base from '../../layouts/Base.astro';
import { IMG_BASE } from '../../lib/data';
/** Game viewer: a sim-style board replayed step by step from the matchup's JSON bundle (/replays/data/A__B.json).
 *  One static page for every game (?p=A|B&id=…) keeps the site at one file per matchup rather than one per game. */
---
<Base title="Study Game" description="Step through a high-bounty ranked game on a sim-style board: every draw, play, attack and counter, with hands, trash and remaining deck." wide>
  <div id="rg" data-img={IMG_BASE}>
    <div class="hero rg-hero"><div style="flex:1"><div class="small"><a href="/replays/" class="muted">← Study Games</a></div><h1 style="margin:.3rem 0 .2rem">Loading game…</h1><div class="meta muted">Fetching the combat log.</div></div></div>
  </div>
</Base>

<script>
  const root = document.getElementById('rg')!;
  const IMG = root.dataset.img!;
  const q = new URLSearchParams(location.search);
  const pair = q.get('p') || '', id = q.get('id') || '';
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
  const CARD = /\[([A-Z]{1,3}\d{2}-\d{3}(?:_p\d+)?)\]/g;
  type Player = { seat: 1 | 2; leader: string; bounty: number; won: boolean; first: boolean; deck: string | null; mulligan: string[] | null };
  type Step = ['m', 1 | 2, string, number, number, 0 | 1, number, number, number, number] | ['e', 0 | 1 | 2, string, string] | ['s', 1 | 2, string[], string[], string[], number];
  type Game = { id: string; ts: string; date: string; players: Player[]; winner: 1 | 2; endTurns: number; end: { how: string; loserLife: number | null }; steps: Step[] };
  type Bundle = { pair: string; leaders: Record<string, { name: string; color: string }>; names: Record<string, string>; games: Record<string, Game> };
  type Char = { id: string; rested: boolean; don: number };
  type Side = { deck: number; hand: string[]; chars: Char[]; stage: string | null; life: string[]; trash: string[]; donDeck: number; donArea: number; donRested: number; donAtt: number; leaderRested: boolean; leaderDon: number };

  const fail = (msg: string) => { root.innerHTML = `<div class="hero rg-hero"><div style="flex:1"><div class="small"><a href="/replays/" class="muted">← Study Games</a></div><h1 style="margin:.3rem 0 .2rem">Game not available</h1><div class="meta muted">${esc(msg)}</div></div></div>`; };

  function start(B: Bundle, G: Game) {
    const name = (c: string) => B.names[c] ?? c;
    const lname = (code: string) => B.leaders[code]?.name ?? name(code);
    const lcolor = (code: string) => B.leaders[code]?.color ?? 'var(--dim)';
    const P: Record<number, Player> = {}; for (const p of G.players) P[p.seat] = p;
    const W = P[G.winner], L = P[G.winner === 1 ? 2 : 1];
    const ending = G.end.how === 'lethal' ? 'took lethal' : G.end.how === 'concede' ? (G.end.loserLife == null ? 'conceded' : `conceded at ${G.end.loserLife} life`) : (G.end.loserLife == null ? 'ended' : `ended at ${G.end.loserLife} life`);
    const deckOf = (p: Player) => { const m = new Map<string, number>(); for (const t of (p.deck || '').split(/\s+/).filter(Boolean)) { const [qn, cid] = t.split('x'); m.set(cid, (m.get(cid) ?? 0) + Number(qn)); } return m; };
    document.title = `${lname(P[1].leader)} vs ${lname(P[2].leader)} · ${G.date} · OPTCG Data`;

    // narrative step indices: the user moves between these; moves and snapshots in between are applied silently
    // narrative steps; the opening hands (both players' first draws, mulligans and life placement) collapse into one step
    const allEvents = G.steps.map((s, i) => (s[0] === 'e' ? i : -1)).filter((i) => i >= 0);
    const SETUP = new Set(['draw', 'mull', 'info']);
    let setupEnd = allEvents.findIndex((si) => !SETUP.has((G.steps[si] as Extract<Step, { 0: 'e' }>)[2]));
    if (setupEnd < 0) setupEnd = allEvents.length;
    const label: Record<number, string> = {};
    const events = setupEnd > 1 ? [allEvents[setupEnd - 1], ...allEvents.slice(setupEnd)] : allEvents;
    if (setupEnd > 1) label[allEvents[setupEnd - 1]] = 'Opening hands drawn, life set';
    const turnStarts: number[] = [0]; // event index where each turn begins
    events.forEach((si, ei) => { const s = G.steps[si]; if (s[0] === 'e' && s[2] === 'end' && ei + 1 < events.length) turnStarts.push(ei + 1); });
    const KIND_LABEL: Record<string, string> = { draw: 'Draw', don: 'DON', deploy: 'Play', attack: 'Attack', combat: 'Battle', hit: 'Damage', fail: 'Blocked', block: 'Blocker', counter: 'Counter', trash: 'Trash', mull: 'Mulligan', effect: 'Effect', end: 'End turn', concede: 'Concede', info: '' };

    const fresh = (): Side => ({ deck: 50, hand: [], chars: [], stage: null, life: [], trash: [], donDeck: 10, donArea: 0, donRested: 0, donAtt: 0, leaderRested: false, leaderDon: 0 });
    let S: Record<number, Side> = { 1: fresh(), 2: fresh() };
    let active = 1, turn = 1, hl: { atk?: string; tgt?: string; seat?: number; done?: boolean } = {}, cur = 0;
    const take = (arr: string[], cid: string) => { const i = arr.indexOf(cid); if (i >= 0) arr.splice(i, 1); return i >= 0; };
    const zoneList = (s: Side, z: number): string[] | null => z === 1 ? s.hand : z === 6 ? s.trash : z === 3 ? s.life : null;
    const applyMove = (st: Extract<Step, { 0: 'm' }>) => {
      const [, seat, cid, zf, zt, rested, deck, donDeck, donArea, donAtt] = st; const s = S[seat];
      s.deck = deck; s.donDeck = donDeck; s.donArea = donArea; s.donAtt = donAtt;
      if (cid === 'Don') {
        if (zf === 5 && zt === 5 && rested) s.donRested++;
        else if (zf === 9 && zt === 5) s.donRested++;
        else if (zf === 5 && zt === 4) s.donRested = Math.min(s.donRested, s.donArea);
        s.donRested = Math.max(0, Math.min(s.donRested, s.donArea));
        return;
      }
      if (zf === 2) { const i = s.chars.findIndex((c) => c.id === cid); if (i >= 0) s.chars.splice(i, 1); }
      else if (zf === 7) { if (s.stage === cid) s.stage = null; }
      else { const l = zoneList(s, zf); if (l) take(l, cid); }
      if (zt === 2) s.chars.push({ id: cid, rested: false, don: 0 });
      else if (zt === 7) s.stage = cid;
      else { const l = zoneList(s, zt); if (l) l.push(cid); }
    };
    const applySnap = (st: Extract<Step, { 0: 's' }>) => {
      const [, seat, hand, chars, trash, life] = st; const s = S[seat];
      s.hand = [...hand]; s.trash = [...trash];
      const old = [...s.chars]; s.chars = chars.map((cid) => { const i = old.findIndex((c) => c.id === cid); return i >= 0 ? old.splice(i, 1)[0] : { id: cid, rested: false, don: 0 }; });
      while (s.life.length > life) s.life.shift(); while (s.life.length < life) s.life.push('?');
    };
    const ATTACH = /^Attach (\d+) (Rested )?Don to .*\[([A-Z0-9]+-\d+(?:_p\d+)?)\](?: \((\d+) Total\))?$/;
    const applyEvent = (st: Extract<Step, { 0: 'e' }>) => {
      const [, seat, kind, text] = st;
      // the attacker/target glow lasts from the attack through counters and blocks until the battle resolves
      if (hl.done || kind === 'end' || kind === 'deploy' || kind === 'draw' || kind === 'don') hl = {};
      if (kind === 'hit' || kind === 'fail') hl.done = true;
      if (!seat) return;
      const s = S[seat];
      // leaders may be alt-art prints whose id differs from the archive's, so anything that is not a character on board is the leader
      const isChar = (side: Side, cid: string) => side.chars.some((c) => c.id === cid);
      if (kind === 'attack') { const ids = [...text.matchAll(CARD)].map((m) => m[1]); let atk = ids[0], tgt = ids[1]; const o = S[3 - seat];
        if (!isChar(s, atk)) { atk = P[seat].leader; s.leaderRested = true; } else { const c = s.chars.find((c) => c.id === atk && !c.rested) ?? s.chars.find((c) => c.id === atk); if (c) c.rested = true; }
        if (tgt && !isChar(o, tgt)) tgt = P[3 - seat].leader;
        hl = { atk, tgt, seat }; return; }
      const a = ATTACH.exec(text);
      if (a) { const n = Number(a[1]), total = a[4] ? Number(a[4]) : null, tid = a[3];
        const c = s.chars.find((c) => c.id === tid); if (c) c.don = total ?? c.don + n; else s.leaderDon = total ?? s.leaderDon + n; }
      if (kind === 'end') { active = 3 - seat; turn++; const n = S[active]; n.chars.forEach((c) => { c.rested = false; c.don = 0; }); n.leaderRested = false; n.leaderDon = 0; n.donRested = 0; }
    };
    const rebuild = (toEvent: number) => {
      S = { 1: fresh(), 2: fresh() }; active = 1; turn = 1; hl = {};
      const last = events[Math.min(toEvent, events.length - 1)];
      for (let i = 0; i <= last; i++) { const st = G.steps[i]; if (st[0] === 'm') applyMove(st); else if (st[0] === 's') applySnap(st); else applyEvent(st); }
      cur = toEvent;
    };

    // ---- rendering: a play mat like the sim's, mirrored for the top player (their character area faces yours)
    let flip = false, showHands = true, peek: { seat: number; zone: 'deck' | 'trash' | 'life' | 'hand' } | null = null;
    // attached DON are drawn like the sim: DON cards tucked behind the card, each peeking out below with its +1000
    const card = (cid: string, cls = '', badge = '', extra = '') => {
      if (cid === '?') return `<span class="cd back ${cls}"><i>?</i></span>`;
      const inner = `<span class="cd ${cls}" ${extra} title="${esc(name(cid))} · ${cid}"><img src="${IMG}${cid}.webp" alt="${esc(name(cid))}" loading="lazy">${badge.startsWith('<b') ? badge : ''}</span>`;
      // the wrapper carries the rested rotation so attached DON turn sideways with their card, as in the sim
      return badge.startsWith('<span class="atts"') ? `<span class="cwrap${/\brested\b/.test(cls) ? ' rested' : ''}">${badge}${inner}</span>` : inner;
    };
    const donBadge = (n: number) => n ? `<span class="atts" title="${n} DON attached (+${n}000 power)">${Array.from({ length: n }, (_, k) => `<span class="att" style="--k:${k}"></span>`).join('')}</span>` : '';
    const rich = (text: string) => esc(text).replace(CARD, (_m, cid: string) => `<span class="ct" title="${esc(name(cid))} · ${cid}"><img src="${IMG}${cid}.webp" alt="${cid}" loading="lazy"></span>`);
    const back = (cls = '', inner = '') => `<span class="cd back ${cls}">${inner}</span>`;
    const halfHtml = (seat: number, top: boolean) => {
      const s = S[seat], p = P[seat], isActive = active === seat;
      const hlCls = (cid: string) => `${hl.atk === cid && hl.seat === seat ? ' atk' : ''}${hl.tgt === cid && hl.seat !== seat ? ' tgt' : ''}`;
      const chars = s.chars.map((c, i) => `<span class="cslot">${card(c.id, `char${c.rested ? ' rested' : ''}${hlCls(c.id)}`, donBadge(c.don), `data-card="${c.id}" data-seat="${seat}" data-i="${i}"`)}</span>`).join('') + Array.from({ length: Math.max(0, 5 - s.chars.length) }, () => '<span class="cslot"><span class="slot"></span></span>').join('');
      const leader = card(p.leader, `leader${s.leaderRested ? ' rested' : ''}${hlCls(p.leader)}`, donBadge(s.leaderDon), `data-card="${p.leader}" data-seat="${seat}"`);
      const stage = s.stage ? card(s.stage, 'stage') : `<span class="slot stage-slot"><i>Stage</i></span>`;
      const donActive = Math.max(0, s.donArea - s.donRested);
      const tokens = Array.from({ length: s.donArea }, (_, i) => `<span class="tok${i >= donActive ? ' rested' : ''}"></span>`).join('');
      const life = `<button type="button" class="pile life" data-peek="life" data-seat="${seat}" title="Life · face down in the real game"><span class="stack">${Array.from({ length: Math.min(s.life.length, 6) }, (_, i) => `<span class="lc" style="--i:${i}"></span>`).join('') || '<span class="lc empty-life"></span>'}</span><b>${s.life.length}</b><span class="pl">Life</span></button>`;
      const deck = `<button type="button" class="pile deck" data-peek="deck" data-seat="${seat}" title="Deck"><span class="cd back"></span><b>${s.deck}</b><span class="pl">Deck</span></button>`;
      const trash = `<button type="button" class="pile trash" data-peek="trash" data-seat="${seat}" title="Trash">${s.trash.length ? card(s.trash[s.trash.length - 1], 'trash-top') : '<span class="cd slot"></span>'}<b>${s.trash.length}</b><span class="pl">Trash</span></button>`;
      const donDeck = `<span class="pile dondeck" title="DON deck"><span class="cd back don"></span><b>${s.donDeck}</b><span class="pl">DON</span></span>`;
      const cost = `<div class="area cost"><span class="al">Cost · ${donActive} active${s.donRested ? ` · ${s.donRested} rested` : ''}${s.donAtt ? ` · ${s.donAtt} attached` : ''}</span><div class="toks">${tokens || '<span class="dim small">no DON yet</span>'}</div></div>`;
      const charArea = `<div class="area chars"><span class="al">Character area</span><div class="cards">${chars}</div></div>`;
      const mid = `<div class="mid">${life}${donDeck}${cost}<div class="center">${leader}${stage}</div>${deck}${trash}</div>`;
      const label = `<div class="who" style="--lc:${lcolor(p.leader)}"><span class="rg-seat">P${seat}</span> <b>${esc(lname(p.leader))}</b><span class="muted small"> · ${p.first ? 'first' : 'second'} · ฿${Math.round(p.bounty).toLocaleString()}${p.won ? ' · <span class="good">winner</span>' : ''}</span>${isActive ? '<span class="turnpill">Active</span>' : ''}</div>`;
      return `<section class="half${top ? ' top' : ' bottom'}${isActive ? ' active' : ''}" style="--lc:${lcolor(p.leader)}">${top ? label + mid + charArea : charArea + mid + label}</section>`;
    };
    const handHtml = (seat: number, top: boolean) => {
      const s = S[seat];
      const cards = showHands ? s.hand.map((c) => card(c, 'hc')).join('') : Array.from({ length: s.hand.length }, () => back('hc')).join('');
      return `<div class="handrow${top ? ' top' : ' bottom'}" style="--lc:${lcolor(P[seat].leader)}"><button type="button" class="hl-btn" data-peek="hand" data-seat="${seat}"><span class="rg-seat">P${seat}</span> Hand · ${s.hand.length}</button><div class="cards">${cards || '<span class="dim small empty">empty</span>'}</div></div>`;
    };
    const logHtml = () => {
      const from = Math.max(0, cur - 9);
      return `<div class="log" id="log">${events.slice(from, cur + 1).map((si, k) => { const e = G.steps[si] as Extract<Step, { 0: 'e' }>; const isCur = from + k === cur; const seat = e[1];
        return `<div class="lg k-${label[si] ? 'setup' : e[2]}${isCur ? ' cur' : ''}"${seat && !label[si] ? ` style="--lc:${lcolor(P[seat].leader)}"` : ''}>${seat && !label[si] ? `<span class="rg-seat">P${seat}</span>` : '<span class="rg-seat none"></span>'}<span class="tx">${label[si] ? esc(label[si]) : rich(e[3])}</span></div>`; }).join('')}</div>`;
    };
    const phaseOf = () => { if (label[events[cur]]) return 'Setup'; const e = G.steps[events[cur]] as Extract<Step, { 0: 'e' }>; return KIND_LABEL[e[2]] || 'Turn'; };
    const peekHtml = () => {
      if (!peek) return '';
      const s = S[peek.seat], p = P[peek.seat];
      let title = '', body = '';
      if (peek.zone === 'trash') { title = `Trash · ${s.trash.length}`; body = s.trash.length ? [...s.trash].reverse().map((c) => card(c)).join('') : '<span class="dim">empty</span>'; }
      else if (peek.zone === 'life') { title = `Life · ${s.life.length}`; body = `<p class="muted small">Face down in the real game. The log records them, so you can peek. Top of the stack first.</p>` + (s.life.length ? [...s.life].reverse().map((c) => card(c)).join('') : '<span class="dim">none</span>'); }
      else if (peek.zone === 'hand') { title = `Hand · ${s.hand.length}`; body = s.hand.length ? s.hand.map((c) => card(c)).join('') : '<span class="dim">empty</span>'; }
      else {
        const dk = deckOf(p);
        if (!dk.size) { title = `Deck · ${s.deck} cards`; body = '<span class="muted">Decklist not recorded for this player, so the remaining cards are unknown.</span>'; }
        else { for (const c of [...s.hand, ...s.chars.map((c) => c.id), ...s.trash, ...s.life, ...(s.stage ? [s.stage] : [])]) if (dk.has(c)) dk.set(c, dk.get(c)! - 1);
          const left = [...dk.entries()].filter(([, n]) => n > 0).sort((a, b) => a[0].localeCompare(b[0]));
          title = `Deck · ${s.deck} cards left`; body = `<p class="muted small">Decklist minus everything seen so far. Order unknown.</p>` + left.map(([c, n]) => card(c, '', `<b class="qty">${n}</b>`)).join(''); }
      }
      return `<div class="peek" style="--lc:${lcolor(p.leader)}"><div class="peek-h"><span class="rg-seat">P${peek.seat}</span> <b>${esc(title)}</b><button type="button" class="copy" data-close-peek>✕</button></div><div class="cards wrap">${body}</div></div>`;
    };
    const render = () => {
      const topSeat = flip ? 1 : 2, botSeat = 3 - topSeat;
      root.innerHTML = `
        <div class="rg-bar"><a href="/replays/?a=${P[1].leader}&b=${P[2].leader}" class="muted small">← Study Games</a>
          <span class="rg-title"><b style="color:${lcolor(P[1].leader)}">${esc(lname(P[1].leader))}</b> <span class="muted">vs</span> <b style="color:${lcolor(P[2].leader)}">${esc(lname(P[2].leader))}</b></span>
          <span class="muted small">${G.date} · <b style="color:${lcolor(W.leader)}">${esc(lname(W.leader))}</b> won in ${G.endTurns} turns, ${esc(lname(L.leader))} ${ending}</span></div>
        <div class="table">
          <div class="mat" id="mat">${handHtml(topSeat, true)}${halfHtml(topSeat, true)}${halfHtml(botSeat, false)}${handHtml(botSeat, false)}<svg class="arrow" id="arrow"></svg></div>
          <aside class="dock">
            <div class="turnbox"><span class="tb-turn">Turn ${turn}</span><span class="tb-who" style="--lc:${lcolor(P[active].leader)}"><span class="rg-seat">P${active}</span> ${esc(lname(P[active].leader))}</span><span class="tb-phase">${esc(phaseOf())}</span></div>
            ${logHtml()}
            <div class="ctl" id="ctl">
              <div class="ctl-row"><button type="button" class="copy" data-go="turn-1" title="Previous turn (Shift+←)">◀◀</button><button type="button" class="copy" data-go="-1" title="Previous step (←)">◀</button><button type="button" class="copy big" data-go="1" title="Next step (→ or Space)">▶</button><button type="button" class="copy" data-go="turn+1" title="Next turn (Shift+→)">▶▶</button></div>
              <input type="range" id="scrub" min="0" max="${events.length - 1}" value="${cur}" aria-label="Step">
              <div class="ctl-row small muted"><span>step ${cur + 1} / ${events.length}</span><span style="margin-left:auto"></span><button type="button" class="copy sm" data-flip title="Swap which player is at the bottom">Flip</button><button type="button" class="copy sm${showHands ? ' on' : ''}" data-hands title="Show or hide both hands">Hands</button></div>
            </div>
            ${peekHtml()}
          </aside>
        </div>`;
      wire(); drawArrow();
    };
    const drawArrow = () => {
      const svg = document.getElementById('arrow') as unknown as SVGSVGElement | null, mat = document.getElementById('mat');
      if (!svg || !mat) return;
      const a = mat.querySelector<HTMLElement>('.cd.atk'), t = mat.querySelector<HTMLElement>('.cd.tgt');
      const done = hl.done;
      if (!a || !t) { svg.innerHTML = ''; return; }
      const m = mat.getBoundingClientRect(), ra = a.getBoundingClientRect(), rt = t.getBoundingClientRect();
      const x1 = ra.left + ra.width / 2 - m.left, y1 = ra.top + ra.height / 2 - m.top, x2 = rt.left + rt.width / 2 - m.left, y2 = rt.top + rt.height / 2 - m.top;
      const dx = x2 - x1, dy = y2 - y1, len = Math.hypot(dx, dy) || 1, ux = dx / len, uy = dy / len, r = Math.min(rt.width, rt.height) / 2 + 6;
      const ex = x2 - ux * r, ey = y2 - uy * r;
      svg.setAttribute('viewBox', `0 0 ${m.width} ${m.height}`); svg.setAttribute('width', String(m.width)); svg.setAttribute('height', String(m.height));
      svg.innerHTML = `<defs><marker id="ah" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="${done ? 'var(--muted)' : 'var(--bad)'}"/></marker></defs><line x1="${x1}" y1="${y1}" x2="${ex}" y2="${ey}" stroke="${done ? 'var(--muted)' : 'var(--bad)'}" stroke-width="4" stroke-linecap="round" marker-end="url(#ah)" opacity="${done ? .55 : .95}"/>`;
    };
    const go = (n: number) => { rebuild(Math.max(0, Math.min(events.length - 1, n))); render(); };
    const turnOf = (ei: number) => { let t = 0; for (let i = 0; i < turnStarts.length; i++) if (turnStarts[i] <= ei) t = i; return t; };
    const wire = () => {
      const ctl = document.getElementById('ctl')!;
      ctl.querySelectorAll<HTMLButtonElement>('[data-go]').forEach((b) => b.addEventListener('click', () => { const g = b.dataset.go!;
        if (g === 'turn-1') { const t = turnOf(cur); go(turnStarts[cur === turnStarts[t] ? Math.max(0, t - 1) : t]); }
        else if (g === 'turn+1') { const t = turnOf(cur); go(t + 1 < turnStarts.length ? turnStarts[t + 1] : events.length - 1); }
        else go(cur + Number(g)); }));
      (document.getElementById('scrub') as HTMLInputElement).addEventListener('input', (e) => go(Number((e.target as HTMLInputElement).value)));
      ctl.querySelector('[data-flip]')!.addEventListener('click', () => { flip = !flip; render(); });
      ctl.querySelector('[data-hands]')!.addEventListener('click', () => { showHands = !showHands; localStorage.setItem('rg-hands', showHands ? '1' : '0'); render(); });
      root.querySelectorAll<HTMLButtonElement>('[data-peek]').forEach((b) => b.addEventListener('click', () => { const z = b.dataset.peek as 'deck' | 'trash' | 'life' | 'hand'; const seat = Number(b.dataset.seat); peek = peek && peek.seat === seat && peek.zone === z ? null : { seat, zone: z }; render(); document.querySelector('.peek')?.scrollIntoView({ block: 'nearest', behavior: 'smooth' }); }));
      root.querySelector('[data-close-peek]')?.addEventListener('click', () => { peek = null; render(); });
      const lg = document.getElementById('log'); lg?.scrollTo({ top: lg.scrollHeight });
    };
    window.addEventListener('resize', drawArrow);
    document.addEventListener('keydown', (e) => { if ((e.target as HTMLElement).tagName === 'INPUT') return;
      if (e.key === 'ArrowRight' || e.key === ' ' || e.key === 'j') { e.preventDefault(); if (e.shiftKey) { const t = turnOf(cur); go(t + 1 < turnStarts.length ? turnStarts[t + 1] : events.length - 1); } else go(cur + 1); }
      if (e.key === 'ArrowLeft' || e.key === 'k') { e.preventDefault(); if (e.shiftKey) { const t = turnOf(cur); go(turnStarts[cur === turnStarts[t] ? Math.max(0, t - 1) : t]); } else go(cur - 1); }
      if (e.key === 'Home') go(0); if (e.key === 'End') go(events.length - 1); });
    let sx = 0, sy = 0, st0 = 0;
    root.addEventListener('touchstart', (e) => { sx = e.touches[0].clientX; sy = e.touches[0].clientY; st0 = Date.now(); }, { passive: true });
    root.addEventListener('touchend', (e) => { if ((e.target as HTMLElement).closest('.cards, input, .ticker')) return; const dx = e.changedTouches[0].clientX - sx, dy = e.changedTouches[0].clientY - sy; if (Date.now() - st0 < 600 && Math.abs(dx) > 60 && Math.abs(dx) > 2 * Math.abs(dy)) go(cur + (dx < 0 ? 1 : -1)); }, { passive: true });
    showHands = localStorage.getItem('rg-hands') !== '0';
    const startAt = Number(q.get('s') || 0);
    go(Number.isFinite(startAt) ? startAt : 0);
  }

  if (!pair || !id) fail('This link is missing the matchup or game id.');
  else fetch(`/replays/data/${pair.replace('|', '__')}.json`).then((r) => { if (!r.ok) throw new Error(`HTTP ${r.status}`); return r.json() as Promise<Bundle>; })
    .then((B) => { const G = B.games[id]; if (!G) throw new Error('This game is no longer in the selection; it may have aged out of the window.'); if (!G.steps) throw new Error('This game was stored in an older format; it will be rebuilt by the next data run.'); start(B, G); })
    .catch((e: Error) => fail(e.message));
</script>
