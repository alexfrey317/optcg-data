---
import Base from '../../layouts/Base.astro';
import LadderPage from '../../components/LadderPage.astro';
import { players, LADDER_PAGE, fmt } from '../../lib/data';

// page 1 is the home page (see astro.config redirects); pages 2+ are generated here
export function getStaticPaths() {
  const pages = Math.ceil(players.length / LADDER_PAGE);
  return Array.from({ length: pages - 1 }, (_, i) => ({ params: { page: String(i + 2) } }));
}
const page = Number(Astro.params.page);
const first = (page - 1) * LADDER_PAGE + 1, last = Math.min(page * LADDER_PAGE, players.length);
---
<Base title={`Ladder #${fmt(first, 0)}–${fmt(last, 0)}`} wide><LadderPage page={page} /></Base>
