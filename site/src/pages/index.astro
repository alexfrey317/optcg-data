---
import Base from '../layouts/Base.astro';
import LeaderChip from '../components/LeaderChip.astro';
import Sparkline from '../components/Sparkline.astro';
import { players, meta, fmt, pct, flag, bountyHistory } from '../lib/data';

const rows = players.map((p) => ({ ...p, hist: p.id != null ? bountyHistory(p.id).map((h) => h[1]) : [] }));
const countries = [...new Set(players.map((p) => p.country).filter(Boolean))].sort() as string[];
const leaderCodes = [...new Set(players.flatMap((p) => p.topLeaders.map((t) => t.code)))];
const totalMatches = players.reduce((n, p) => n + (p.matches || 0), 0);
---
<Base title="Ranked ladder">
  <h1>OPTCG Sim ranked ladder <span class="muted" style="font-size:1rem;font-weight:400">top {fmt(players.length, 0)} · Standard</span></h1>

  <div class="grid stats" style="margin-bottom:1rem">
    <div class="stat"><div class="label">Top bounty</div><div class="value">{fmt(players[0]?.bounty, 0)}</div></div>
    <div class="stat"><div class="label">#1000 bounty</div><div class="value">{fmt(players.at(-1)?.bounty, 0)}</div></div>
    <div class="stat"><div class="label">Matches by top {fmt(players.length, 0)}</div><div class="value">{fmt(totalMatches, 0)}</div></div>
    <div class="stat"><div class="label">Snapshot</div><div class="value" style="font-size:1rem">{meta.date}</div></div>
  </div>

  <div class="toolbar">
    <input type="search" id="q" placeholder="Search player…" autocomplete="off" />
    <select id="country"><option value="">All countries</option>{countries.map((c) => <option value={c}>{flag(c)} {c}</option>)}</select>
    <select id="leader"><option value="">Any leader</option>{leaderCodes.map((c) => <option value={c}>{c}</option>)}</select>
    <select id="faction"><option value="">Marines & Pirates</option><option>Marine</option><option>Pirate</option></select>
    <span class="muted" id="count"></span>
  </div>

  <div class="panel" style="padding:0;overflow:auto">
    <table id="ladder">
      <thead><tr>
        <th class="num sortable sorted" data-k="rank">#</th>
        <th>Player</th>
        <th class="num sortable" data-k="bounty">Bounty</th>
        <th>7-day</th>
        <th class="num sortable" data-k="matches">Games</th>
        <th class="num sortable" data-k="winRate">Win %</th>
        <th>Top leaders</th>
      </tr></thead>
      <tbody>
        {rows.map((p) => (
          <tr data-name={p.name.toLowerCase()} data-country={p.country ?? ''} data-faction={p.faction} data-leaders={p.topLeaders.map((t) => t.code).join(' ')}
              data-rank={p.rank} data-bounty={p.bounty} data-matches={p.matches} data-winrate={p.winRate}>
            <td class="num muted">{p.rank}</td>
            <td><a href={p.id != null ? `/players/${p.id}/` : undefined} style="font-weight:600">{p.name}</a>
              <span class="muted" style="font-size:.8rem"> {flag(p.country)} {p.faction === 'Marine' ? '⚓' : '☠'}</span></td>
            <td class="num" style="font-weight:600;color:var(--accent)">{fmt(p.bounty, 0)}</td>
            <td><Sparkline points={p.hist} width={90} height={22} /></td>
            <td class="num">{fmt(p.matches, 0)} <span class="muted" style="font-size:.75rem">{p.wins}-{p.losses}</span></td>
            <td class:list={['num', p.winRate >= 50 ? 'good' : 'bad']}>{p.matches ? pct(p.winRate) : <span class="muted">–</span>}</td>
            <td style="white-space:nowrap">{p.topLeaders.slice(0, 3).map((t) => <LeaderChip code={t.code} suffix={`${fmt(t.winRate)}% · ${t.matches}`} />)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="muted" style="font-size:.8rem">Bounty and records from the OPBounty Standard ladder. Sparkline shows daily bounty since we started tracking this player.</p>

  <script>
    const tbody = document.querySelector('#ladder tbody')!;
    const rows = [...tbody.querySelectorAll('tr')] as HTMLTableRowElement[];
    const q = document.getElementById('q') as HTMLInputElement;
    const sel = (id: string) => document.getElementById(id) as HTMLSelectElement;
    const count = document.getElementById('count')!;
    let sortKey = 'rank', asc = true;
    function apply() {
      const term = q.value.trim().toLowerCase(), country = sel('country').value, leader = sel('leader').value, faction = sel('faction').value;
      let shown = 0;
      for (const r of rows) {
        const ok = (!term || r.dataset.name!.includes(term)) && (!country || r.dataset.country === country)
          && (!leader || r.dataset.leaders!.split(' ').includes(leader)) && (!faction || r.dataset.faction === faction);
        r.hidden = !ok; if (ok) shown++;
      }
      count.textContent = `${shown} players`;
      rows.sort((a, b) => (Number(a.dataset[sortKey]) - Number(b.dataset[sortKey])) * (asc ? 1 : -1));
      tbody.append(...rows);
    }
    q.addEventListener('input', apply);
    for (const id of ['country', 'leader', 'faction']) sel(id).addEventListener('change', apply);
    document.querySelectorAll('th.sortable').forEach((th) => th.addEventListener('click', () => {
      const k = (th as HTMLElement).dataset.k!.toLowerCase();
      if (sortKey === k) asc = !asc; else { sortKey = k; asc = k === 'rank'; }
      document.querySelectorAll('th.sortable').forEach((t) => t.classList.remove('sorted', 'asc'));
      th.classList.add('sorted'); if (asc) th.classList.add('asc');
      apply();
    }));
    apply();
  </script>
</Base>
