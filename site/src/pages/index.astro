---
import Base from '../layouts/Base.astro';
import LadderTable from '../components/LadderTable.astro';
import Info from '../components/Info.astro';
import { players, top1000, leaders, seasonRecord, fmt, berry, flag } from '../lib/data';

const countries = [...new Set(top1000.map((p) => p.country).filter(Boolean))].sort() as string[];
const leaderCodes = [...new Set(top1000.flatMap((p) => p.topLeaders.map((t) => t.code)))].sort((a, b) => (leaders[a]?.name ?? a).localeCompare(leaders[b]?.name ?? b));
const totalMatches = top1000.reduce((n, p) => n + (seasonRecord(p).games || 0), 0);
---
<Base title="Ranked Ladder" wide>
  <div class="hero">
    <div>
      <h1>OPTCG Sim Ranked Ladder</h1>
      <div class="meta">Top {fmt(top1000.length, 0)} players on the Standard ranked ladder, with the leaders they pilot and the lists winning with those leaders. Updated once a day.{players.length > top1000.length && <> The <a href="/ladder/1/">full ladder</a> goes to #{fmt(players.length, 0)}.</>}</div>
    </div>
  </div>

  <div class="grid stats">
    <div class="stat"><div class="label">Top Bounty <Info text="Bounty is your ranked rating. It rises with wins and falls with losses, scaled by opponent strength, like Elo." /></div><div class="value gold">{berry(top1000[0]?.bounty)}</div></div>
    <div class="stat"><div class="label">#{fmt(top1000.length, 0)} Bounty <Info text="The bounty of the lowest player shown. Anyone above it is on this page." /></div><div class="value">{berry(top1000.at(-1)?.bounty)}</div></div>
    <div class="stat"><div class="label">Ranked Games <Info text="Sum of season ranked games for the players on this page, from their OPBounty profiles where available." /></div><div class="value">{fmt(totalMatches, 0)}</div></div>
    <div class="stat"><div class="label">Leaders in Play <Info text="Distinct leaders that appear among the top three of at least one player on this page." /></div><div class="value">{leaderCodes.length}</div></div>
  </div>

  <div class="toolbar">
    <input type="search" id="q" placeholder="Search player…" autocomplete="off" enterkeyhint="search" />
    <select id="country" aria-label="Country"><option value="">All countries</option>{countries.map((c) => <option value={c}>{flag(c)} {c}</option>)}</select>
    <select id="leader" aria-label="Leader"><option value="">Any leader</option>{leaderCodes.map((c) => <option value={c}>{leaders[c]?.name ?? c} ({c})</option>)}</select>
    <select id="msort" class="m-only" aria-label="Sort by">
      <option value="rank:1">Sort: Rank</option><option value="bounty:-1">Sort: Bounty</option><option value="matches:-1">Sort: Most games</option><option value="winrate:-1">Sort: Win %</option>
    </select>
    <span class="muted" id="count"></span>
  </div>

  <div class="panel scroll">
    <LadderTable rows={top1000} id="ladder" sortable />
  </div>

  <script>
    const tbody = document.querySelector('#ladder tbody')!;
    const rows = [...tbody.querySelectorAll('tr')] as HTMLTableRowElement[];
    const q = document.getElementById('q') as HTMLInputElement;
    const sel = (id: string) => document.getElementById(id) as HTMLSelectElement;
    const count = document.getElementById('count')!;
    let sortKey = 'rank', asc = true;
    // filters survive reloads and tab switches on the same device
    const saved = JSON.parse(sessionStorage.getItem('ladder-filters') || '{}');
    if (saved.q) q.value = saved.q; if (saved.country) sel('country').value = saved.country; if (saved.leader) sel('leader').value = saved.leader;
    function apply() {
      const term = q.value.trim().toLowerCase(), country = sel('country').value, leader = sel('leader').value;
      sessionStorage.setItem('ladder-filters', JSON.stringify({ q: q.value, country, leader }));
      let shown = 0;
      for (const r of rows) {
        const ok = (!term || r.dataset.name!.includes(term)) && (!country || r.dataset.country === country) && (!leader || r.dataset.leaders!.split(' ').includes(leader));
        r.hidden = !ok; if (ok) shown++;
      }
      count.textContent = `${shown} players`;
      rows.sort((a, b) => (Number(a.dataset[sortKey]) - Number(b.dataset[sortKey])) * (asc ? 1 : -1));
      tbody.append(...rows);
    }
    q.addEventListener('input', apply);
    for (const id of ['country', 'leader']) sel(id).addEventListener('change', apply);
    sel('msort').addEventListener('change', () => { const [k, d] = sel('msort').value.split(':'); sortKey = k; asc = d === '1'; apply(); });
    document.querySelectorAll('th.sortable').forEach((th) => th.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('.info')) return;
      const k = (th as HTMLElement).dataset.k!;
      if (sortKey === k) asc = !asc; else { sortKey = k; asc = k === 'rank'; }
      document.querySelectorAll('th.sortable').forEach((t) => t.classList.remove('sorted', 'asc'));
      th.classList.add('sorted'); if (asc) th.classList.add('asc');
      apply();
    }));
    apply();
  </script>
</Base>
