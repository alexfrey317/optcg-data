---
import Base from '../../layouts/Base.astro';
import LeaderArt from '../../components/LeaderArt.astro';
import DeckCard from '../../components/DeckCard.astro';
import Info from '../../components/Info.astro';
import { players, leaders, deckFile, bountyHistory, fmt, pct, flag, type Player } from '../../lib/data';

export function getStaticPaths() {
  return players.filter((p) => p.id != null).map((p) => ({ params: { id: String(p.id) }, props: { player: p } }));
}
const { player } = Astro.props as { player: Player };
const hist = bountyHistory(player.id!);
const W = 720, H = 180;
let path = '', area = '', minB = 0, maxB = 0;
if (hist.length >= 2) {
  const ys = hist.map((h) => h[1]); minB = Math.min(...ys); maxB = Math.max(...ys);
  const span = maxB - minB || 1;
  const pts = ys.map((y, i) => [(i / (ys.length - 1)) * (W - 20) + 10, H - 24 - ((y - minB) / span) * (H - 48)] as const);
  path = pts.map(([x, y], i) => `${i ? 'L' : 'M'}${x.toFixed(1)},${y.toFixed(1)}`).join(' ');
  area = `${path} L${pts.at(-1)![0].toFixed(1)},${H - 24} L10,${H - 24} Z`;
}
const leaderDecks = player.topLeaders.map((t) => {
  const f = deckFile(t.code);
  return { ...t, name: leaders[t.code]?.name ?? t.code, decks: f.decks.slice(0, 3), pilot: f.topPilots.find((p) => p.name === player.name) };
});
const main = player.topLeaders[0];
---
<Base title={`${player.name} · #${player.rank}`}>
  <p style="margin:0 0 .75rem"><a href="/">← Ladder</a></p>
  <div class="hero">
    {main && <LeaderArt code={main.code} size="xl" label={false} />}
    <div style="flex:1">
      <div class="muted small">Rank #{player.rank} · {flag(player.country)} {player.country ?? 'Unknown region'}</div>
      <h1>{player.name}</h1>
      <div class="meta">Mains <b style="color:var(--text)">{main ? leaders[main.code]?.name ?? main.code : '–'}</b>{main && <> at {pct(main.winRate)} over {main.matches} games</>}.</div>
      <div class="grid stats" style="margin-top:1rem">
        <div class="stat"><div class="label">Bounty <Info text="OPBounty ranked rating. Rises with wins and falls with losses, scaled by opponent strength." /></div><div class="value gold">{fmt(player.bounty, 0)}</div></div>
        <div class="stat"><div class="label">Record</div><div class="value">{player.wins}–{player.losses}</div></div>
        <div class="stat"><div class="label">Win rate</div><div class:list={['value', player.winRate >= 50 ? 'good' : 'bad']}>{pct(player.winRate)}</div></div>
        <div class="stat"><div class="label">Ranked games</div><div class="value">{fmt(player.matches, 0)}</div></div>
      </div>
    </div>
  </div>

  <h2>Bounty history <Info text="One point per daily snapshot. We only keep history for players who have appeared in the top 1,000." /></h2>
  <div class="panel">
    {hist.length >= 2 ? (
      <svg viewBox={`0 0 ${W} ${H}`} width="100%" style="max-height:220px;display:block" role="img" aria-label="Bounty over time">
        <defs><linearGradient id="g" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="var(--accent)" stop-opacity=".35"/><stop offset="1" stop-color="var(--accent)" stop-opacity="0"/></linearGradient></defs>
        <path d={area} fill="url(#g)" />
        <path d={path} fill="none" stroke="var(--accent)" stroke-width="2.2" stroke-linejoin="round" />
        <text x="10" y="14" fill="var(--muted)" font-size="11">{fmt(maxB, 0)}</text>
        <text x="10" y={H - 6} fill="var(--muted)" font-size="11">{fmt(minB, 0)}</text>
        <text x={W - 10} y={H - 6} fill="var(--muted)" font-size="11" text-anchor="end">{hist[0][0]} → {hist.at(-1)![0]}</text>
      </svg>
    ) : <p class="muted" style="margin:0">Tracking started {hist[0]?.[0] ?? 'today'}. The chart appears after a second daily snapshot.</p>}
  </div>

  <h2>Leaders played <Info text="OPBounty reports each player's three most-played leaders. Share is that leader's portion of the player's ranked games." /></h2>
  <div class="panel tight">
    <table>
      <thead><tr><th>Leader</th><th class="num">Games</th><th class="num">Win %</th><th class="num">Share</th><th class="num">Leader's ladder win % <Info text="How this leader performs across all ladder players, for comparison with this player's own rate." /></th></tr></thead>
      <tbody>{player.topLeaders.map((t) => { const lw = leaders[t.code]?.sources.opbounty?.winRate ?? leaders[t.code]?.sources.kaizoku?.winRate; return (
        <tr><td><LeaderArt code={t.code} size="md" /></td><td class="num">{fmt(t.matches, 0)}</td>
          <td class:list={['num', (t.winRate ?? 0) >= 50 ? 'good' : 'bad']} style="font-weight:600">{pct(t.winRate)}</td>
          <td class="num">{player.matches ? pct((100 * (t.matches ?? 0)) / player.matches) : '–'}</td>
          <td class="num muted">{pct(lw as number)}</td></tr>
      ); })}</tbody>
    </table>
  </div>

  <h2>What these leaders are winning with <Info text="No free source publishes a player's exact decklist. Shown instead: the top ranked lists for each leader this player pilots, merged from OPBounty, Card Kaizoku and optcg.one." /></h2>
  {leaderDecks.map((L) => (
    <section style="margin-bottom:1.5rem">
      <div style="display:flex;align-items:center;gap:1rem;margin:.5rem 0 .75rem;flex-wrap:wrap">
        <LeaderArt code={L.code} size="lg" sub={`this player: ${pct(L.winRate)} · ${L.matches} games`} />
        {L.pilot && <span class="chip" style="border-color:var(--accent);color:var(--accent-2)">#{L.pilot.rank} {L.name} pilot last week on Card Kaizoku <Info text="Card Kaizoku ranks the top pilots of each leader by weighted win rate over the last week. This player made that list." /></span>}
      </div>
      {L.decks.length ? L.decks.map((d, i) => <DeckCard deck={d} leader={L.code} open={i === 0} />) : <p class="muted">No decklists published for this leader.</p>}
      <p class="small"><a href={`/leaders/${L.code}/`}>All {L.name} decks, matchups and card stats →</a></p>
    </section>
  ))}
</Base>
