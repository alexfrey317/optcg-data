---
import Base from '../../layouts/Base.astro';
import LeaderArt from '../../components/LeaderArt.astro';
import DeckCard from '../../components/DeckCard.astro';
import DeckList from '../../components/DeckList.astro';
import Info from '../../components/Info.astro';
import { players, leaders, bountyHistory, playerDecks, fmt, pct, berry, flag, heat, type Player } from '../../lib/data';

export function getStaticPaths() {
  return players.filter((p) => p.id != null).map((p) => ({ params: { id: String(p.id) }, props: { player: p } }));
}
const { player } = Astro.props as { player: Player };
const hist = bountyHistory(player.id!);
const W = 720, H = 180;
let path = '', area = '', minB = 0, maxB = 0;
if (hist.length >= 2) {
  const ys = hist.map((h) => h[1]); minB = Math.min(...ys); maxB = Math.max(...ys);
  const span = maxB - minB || 1;
  const pts = ys.map((y, i) => [(i / (ys.length - 1)) * (W - 20) + 10, H - 24 - ((y - minB) / span) * (H - 48)] as const);
  path = pts.map(([x, y], i) => `${i ? 'L' : 'M'}${x.toFixed(1)},${y.toFixed(1)}`).join(' ');
  area = `${path} L${pts.at(-1)![0].toFixed(1)},${H - 24} L10,${H - 24} Z`;
}
const main = player.topLeaders[0];
const own = playerDecks(player.id!);
const ownByLeader = own ? own.leaders.map((l) => ({ ...l, decks: own.decks.filter((d) => d.leader === l.code) })).filter((l) => l.decks.length) : [];
const cls = (v: number | null | undefined) => (v == null ? 'dim' : v >= 50 ? 'good' : 'bad');
---
<Base title={`${player.name} · #${player.rank}`}>
  <p style="margin:0 0 .75rem"><a href="/">← Ladder</a></p>
  <div class="hero">
    {main && <LeaderArt code={main.code} size="xl" label={false} />}
    <div style="flex:1">
      <div class="muted small">Rank #{player.rank} · {flag(player.country)} {player.country ?? 'Unknown region'}</div>
      <h1>{player.name}</h1>
      <div class="meta">Mains <b style="color:var(--text)">{main ? leaders[main.code]?.name ?? main.code : '–'}</b>{main && <> at {pct(main.winRate)} over {main.matches} games</>}.</div>
      <div class="grid stats" style="margin-top:1rem">
        <div class="stat"><div class="label">Bounty <Info text="Ranked rating. Rises with wins and falls with losses, scaled by opponent strength." /></div><div class="value gold">{berry(player.bounty)}</div></div>
        <div class="stat"><div class="label">Record</div><div class="value">{player.wins}–{player.losses}</div></div>
        <div class="stat"><div class="label">Win Rate</div><div class:list={['value', player.winRate >= 50 ? 'good' : 'bad']}>{pct(player.winRate)}</div></div>
        <div class="stat"><div class="label">Ranked Games</div><div class="value">{fmt(player.matches, 0)}</div></div>
      </div>
    </div>
  </div>

  <h2>Bounty History <Info text="One point per daily snapshot. We only keep history for players who have appeared in the top 1,000." /></h2>
  <div class="panel">
    {hist.length >= 2 ? (
      <svg viewBox={`0 0 ${W} ${H}`} width="100%" style="max-height:220px;display:block" role="img" aria-label="Bounty over time">
        <defs><linearGradient id="g" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="var(--accent)" stop-opacity=".35"/><stop offset="1" stop-color="var(--accent)" stop-opacity="0"/></linearGradient></defs>
        <path d={area} fill="url(#g)" />
        <path d={path} fill="none" stroke="var(--accent)" stroke-width="2.2" stroke-linejoin="round" />
        <text x="10" y="14" fill="var(--muted)" font-size="11">{fmt(maxB, 0)}</text>
        <text x="10" y={H - 6} fill="var(--muted)" font-size="11">{fmt(minB, 0)}</text>
        <text x={W - 10} y={H - 6} fill="var(--muted)" font-size="11" text-anchor="end">{hist[0][0]} → {hist.at(-1)![0]}</text>
      </svg>
    ) : <p class="muted" style="margin:0">Tracking started {hist[0]?.[0] ?? 'today'}. The chart appears after a second daily snapshot.</p>}
  </div>

  <h2>Leaders Played <Info text="The ladder reports each player's three most-played leaders. Share is that leader's portion of the player's ranked games." /></h2>
  <div class="panel tight">
    <table>
      <thead><tr><th>Leader</th><th class="num">Games</th><th class="num">Win %</th><th class="num">Share</th><th class="num">Leader's Ladder Win % <Info text="How this leader performs across all ladder players, for comparison with this player's own rate." /></th></tr></thead>
      <tbody>{player.topLeaders.map((t) => { const lw = leaders[t.code]?.sources.opbounty?.winRate ?? leaders[t.code]?.sources.kaizoku?.winRate; return (
        <tr><td><LeaderArt code={t.code} size="md" /></td><td class="num">{fmt(t.matches, 0)}</td>
          <td class:list={['num', (t.winRate ?? 0) >= 50 ? 'good' : 'bad']} style="font-weight:600">{pct(t.winRate)}</td>
          <td class="num">{player.matches ? pct((100 * (t.matches ?? 0)) / player.matches) : '–'}</td>
          <td class="num muted">{pct(lw as number)}</td></tr>
      ); })}</tbody>
    </table>
  </div>

  {own && ownByLeader.length > 0 ? (
    <>
      <h2>Decks Played <span class="sub">ranked · {own.window.start} → {own.window.end} · {fmt(own.matches, 0)} games</span> <Info text={`Exact lists this player ran in ranked private-lobby games over the last ${own.window.days} days, from the sim's match records. Games and win rate are this player's own results with each list.`} /></h2>
      <div class="grid stats" style="margin-bottom:1rem">
        <div class="stat"><div class="label">Win rate <Info text="This player's ranked win rate over the window." /></div><div class:list={['value', cls(own.winRate)]}>{pct(own.winRate)}</div></div>
        <div class="stat"><div class="label">Going 1st <Info text="Win rate in games where this player took the first turn." /></div><div class:list={['value', cls(own.turns?.firstWinRate)]}>{pct(own.turns?.firstWinRate)} <span class="muted small">/ {own.turns?.firstGames ?? 0}</span></div></div>
        <div class="stat"><div class="label">Going 2nd</div><div class:list={['value', cls(own.turns?.secondWinRate)]}>{pct(own.turns?.secondWinRate)} <span class="muted small">/ {own.turns?.secondGames ?? 0}</span></div></div>
        <div class="stat"><div class="label">After winning the flip <Info text="Win rate when this player won the coin flip and chose turn order." /></div><div class:list={['value', cls(own.coinflip.winRateAfterWin)]}>{pct(own.coinflip.winRateAfterWin)}</div></div>
        <div class="stat"><div class="label">Avg game length</div><div class="value">{own.avgTurns ? `${fmt(own.avgTurns, 1)} turns` : '–'}</div></div>
      </div>
      {ownByLeader.map((L) => (
        <section style="margin-bottom:1.75rem">
          <div style="display:flex;align-items:center;gap:1rem;margin:.5rem 0 .75rem;flex-wrap:wrap">
            <LeaderArt code={L.code} size="lg" sub={`${pct(L.winRate)} · ${L.games} games · ${L.decks.length} list${L.decks.length === 1 ? '' : 's'}`} />
            {L.turns && <span class="chip">1st {pct(L.turns.firstWinRate)} <span class="muted">/ {L.turns.firstGames}</span></span>}
            {L.turns && <span class="chip">2nd {pct(L.turns.secondWinRate)} <span class="muted">/ {L.turns.secondGames}</span></span>}
          </div>
          {L.matchups.length > 0 && <div class="panel scroll" style="margin-bottom:.6rem"><table class="breakdown">
            <thead><tr><th>vs</th>{L.matchups.map((m) => <th><LeaderArt code={m.opp} size="sm" label={false} /></th>)}</tr></thead>
            <tbody>
              <tr><th>Win rate</th>{L.matchups.map((m) => <td class={cls(m.winRate)} style={`background:${heat(m.winRate)}`}>{pct(m.winRate)}</td>)}</tr>
              <tr><th>Games</th>{L.matchups.map((m) => <td class="muted">{m.games}</td>)}</tr>
            </tbody></table></div>}
          <DeckList limit={3} total={L.decks.length}>{L.decks.map((d, i) => <DeckCard deck={d} leader={L.code} open={i === 0} rank={i + 1} baseline={L.decks[0]} />)}</DeckList>
          <p class="small"><a href={`/leaders/${L.code}/`}>Everyone's {L.name ?? leaders[L.code]?.name ?? L.code} lists, matchups and card stats →</a></p>
        </section>
      ))}
    </>
  ) : (
    <>
      <h2>Decks Played <Info text="Exact lists come from the sim's match records and need the ladder name to match a sim account with recent ranked games. This player's name did not match, so no lists are shown here." /></h2>
      <div class="panel"><p class="muted" style="margin:0">No exact lists for this player yet. See what everyone is winning with on the leader pages: {player.topLeaders.map((t, i) => <>{i > 0 && ' · '}<a href={`/leaders/${t.code}/`}>{leaders[t.code]?.name ?? t.code}</a></>)}</p></div>
    </>
  )}
</Base>
