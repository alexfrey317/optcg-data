---
import Base from '../../layouts/Base.astro';
import Info from '../../components/Info.astro';
import { oplay, oplayDecks, card, colorVar, imgUrl, fmt, formatLabel } from '../../lib/data';
const byLeader = new Map<string, { code: string; name: string; decks: number; wins: number; pilots: Set<string>; best: number | null }>();
for (const d of oplayDecks) {
  const L = byLeader.get(d.leader) ?? { code: d.leader, name: d.leaderName ?? card(d.leader).name, decks: 0, wins: 0, pilots: new Set<string>(), best: null };
  L.decks++; if (d.place === 1) L.wins++; L.pilots.add(d.user);
  if (d.rank != null && (L.best == null || d.rank < L.best)) L.best = d.rank;
  byLeader.set(d.leader, L);
}
const rows = [...byLeader.values()].sort((a, b) => b.wins - a.wins || b.decks - a.decks);
const tournaments = oplay.tournaments.filter((t) => oplayDecks.some((d) => d.t === t.id)).length;
---
<Base title="OPlayTCG Tournament Decks" wide>
<div class="hero"><div style="flex:1"><h1>OPlayTCG Tournament Decks</h1>
  <div class="meta">Exact 50-card lists from completed online tournaments on <a href="https://oplaytcg.com/en/tournaments" target="_blank" rel="noopener">OPlayTCG</a>, {formatLabel} format: every tournament winner plus anyone in the ladder top {fmt(oplay.ladderTop, 0)}. <b style="color:var(--text)">{fmt(oplayDecks.length, 0)}</b> lists from {fmt(tournaments, 0)} tournaments. Updated {oplay.updated}. <Info text="OPlayTCG publishes decklists only for tournament entrants, not for ranked ladder games, so a ladder rank here means that player also entered a tournament. Rank is the pilot's current OPlayTCG ladder position." /></div></div></div>
<div class="panel scroll">
  <table class="rank-table">
    <thead><tr><th class="hide-m">Card</th><th>Leader</th><th class="num">Wins <Info text="Tournaments won with this leader." /></th><th class="num">Lists</th><th class="num hide-m">Pilots</th><th class="num">Best rank <Info text="Highest current ladder rank among the pilots of these lists." /></th></tr></thead>
    <tbody>{rows.map((L) => (
      <tr>
        <td class="hide-m"><a href={`/oplaytcg/${L.code}/`} class="art-wide" style={`--lc:${colorVar(card(L.code).color)}`}><img src={imgUrl(L.code)} alt="" loading="lazy" /></a></td>
        <td><a href={`/oplaytcg/${L.code}/`} class="leader-link"><span class="art-wide art-m" style={`--lc:${colorVar(card(L.code).color)}`}><img src={imgUrl(L.code)} alt="" loading="lazy" /></span><span class="lcode muted">[{L.code}]</span> <span class="lname">{L.name}</span></a></td>
        <td class="num" style="font-weight:700">{L.wins}</td>
        <td class="num">{L.decks}</td>
        <td class="num hide-m">{L.pilots.size}</td>
        <td class="num">{L.best == null ? <span class="dim">–</span> : `#${L.best}`}</td>
      </tr>))}</tbody>
  </table>
</div>
</Base>
