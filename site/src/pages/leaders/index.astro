---
import Base from '../../layouts/Base.astro';
import LeaderArt from '../../components/LeaderArt.astro';
import Info from '../../components/Info.astro';
import { leadersByVolume, fmt, pct, volume, players } from '../../lib/data';

const rows = leadersByVolume().filter((l) => volume(l) > 0);
const pilots = new Map<string, number>();
for (const p of players) for (const t of p.topLeaders) pilots.set(t.code, (pilots.get(t.code) ?? 0) + 1);
---
<Base title="Leaders" wide>
  <div class="hero"><div><h1>Leaders</h1><div class="meta">{rows.length} leaders with ranked games last week. Click a column to sort, a leader to see matchups, decks and card stats.</div></div></div>
  <div class="panel scroll">
    <table id="t">
      <thead><tr>
        <th>Leader</th>
        <th class="num sortable" data-k="play">Play % <Info text="Share of all ranked games last week in which this leader appeared (Card Kaizoku, private lobbies)." /></th>
        <th class="num sortable sorted" data-k="games">Games <Info text="Ranked games last week on Card Kaizoku." /></th>
        <th class="num sortable" data-k="wr">Win % <Info text="Raw win rate across all pilots of the leader last week." /></th>
        <th class="num sortable" data-k="first">Going 1st <Info text="Win rate when this leader took the first turn." /></th>
        <th class="num sortable" data-k="second">Going 2nd <Info text="Win rate when this leader took the second turn." /></th>
        <th class="num sortable" data-k="opb">OPBounty win % <Info text="The same leader's win rate on the OPBounty ladder, a different match pool. Large gaps between the two columns usually mean a small sample." /></th>
        <th class="num sortable" data-k="top">Top-1000 pilots <Info text="How many of the top 1,000 ladder players have this leader among their three most-played." /></th>
        <th class="num">Lists <Info text="Distinct 50-card lists we have for this leader across all sources." /></th>
      </tr></thead>
      <tbody>{rows.map((l) => { const k = l.sources.kaizoku ?? {}, o = l.sources.opbounty ?? {}; const wr = Number(k.winRate ?? o.winRate ?? 0); return (
        <tr data-play={k.playRate ?? 0} data-games={volume(l)} data-wr={wr} data-first={k.firstWinRate ?? 0} data-second={k.secondWinRate ?? 0} data-opb={o.winRate ?? 0} data-top={pilots.get(l.code) ?? 0}>
          <td><LeaderArt code={l.code} size="md" sub={`${l.code} · ${l.color ?? ''}`} /></td>
          <td class="num"><div class="bar" style="width:70px;display:inline-block;vertical-align:middle;margin-right:.4rem"><i style={`width:${Math.min(100, Number(k.playRate ?? 0) * 3)}%`}></i></div>{pct(k.playRate as number)}</td>
          <td class="num">{fmt(k.matches as number, 0)}</td>
          <td class:list={['num', wr >= 50 ? 'good' : 'bad']} style="font-weight:700">{pct(wr)}</td>
          <td class="num">{pct(k.firstWinRate as number)}</td>
          <td class="num">{pct(k.secondWinRate as number)}</td>
          <td class="num">{pct(o.winRate as number)}</td>
          <td class="num">{pilots.get(l.code) ?? 0}</td>
          <td class="num muted">{l.deckCount}</td>
        </tr>); })}</tbody>
    </table>
  </div>
  <script>
    const tbody = document.querySelector('#t tbody')!; const rows = [...tbody.querySelectorAll('tr')] as HTMLElement[];
    let key = 'games', asc = false;
    document.querySelectorAll('th.sortable').forEach((th) => th.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('.info')) return;
      const k = (th as HTMLElement).dataset.k!; if (key === k) asc = !asc; else { key = k; asc = false; }
      document.querySelectorAll('th.sortable').forEach((t) => t.classList.remove('sorted', 'asc')); th.classList.add('sorted'); if (asc) th.classList.add('asc');
      rows.sort((a, b) => (Number(a.dataset[key]) - Number(b.dataset[key])) * (asc ? 1 : -1)); tbody.append(...rows);
    }));
  </script>
</Base>
