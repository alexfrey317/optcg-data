---
import Base from '../../layouts/Base.astro';
import LeaderArt from '../../components/LeaderArt.astro';
import DeckCard from '../../components/DeckCard.astro';
import Info from '../../components/Info.astro';
import { leaders, leadersByVolume, deckFile, cardFile, card, fmt, pct, berry, volume, players, imgUrl, imgOnError, leaderStats, matchup, heat, type Leader } from '../../lib/data';

export function getStaticPaths() {
  return leadersByVolume().filter((l) => volume(l) > 0).map((l) => ({ params: { code: l.code }, props: { leader: l } }));
}
const { leader: L } = Astro.props as { leader: Leader };
const s = leaderStats(L);
const decks = deckFile(L.code);
const cardsF = cardFile(L.code);
const SHOW = 30;
const opps = Object.keys(L.matchups).filter((o) => leaders[o] && matchup(L.code, o)).map((o) => ({ code: o, m: matchup(L.code, o)! }))
  .sort((a, b) => b.m.games - a.m.games).slice(0, 18);
const topPilotsOnLadder = players.filter((p) => p.topLeaders.some((t) => t.code === L.code)).slice(0, 10);
const techOpps = Object.entries(cardsF.tech).filter(([opp]) => leaders[opp]).slice(0, 10);
const cls = (v: number | null) => (v == null ? 'dim' : v >= 50 ? 'good' : 'bad');
---
<Base title={`${L.name} [${L.code}]`} wide>
  <p style="margin:0 0 .75rem"><a href="/leaders/">← Leader rankings</a></p>

  <div class="hero" style="align-items:stretch">
    <LeaderArt code={L.code} size="xl" label={false} link={false} />
    <div style="flex:1;display:flex;flex-direction:column;justify-content:center">
      <h1 style="text-align:center;margin-bottom:1rem">{L.name} <span class="sub">[{L.code}] · {L.color}</span></h1>
      <div class="grid stats" style="grid-template-columns:repeat(3,1fr)">
        <div class="stat"><div class="label">Weighted win rate <Info text="Raw win rate shrunk toward 50% for small samples." /></div><div class:list={['value', cls(s.weighted ?? s.winRate)]}>{pct(s.weighted ?? s.winRate)}</div></div>
        <div class="stat"><div class="label">Play rate <Info text="Share of all ranked games in which this leader appeared last week." /></div><div class="value">{pct(s.playRate)}</div></div>
        <div class="stat"><div class="label">Total games</div><div class="value">{fmt(s.games, 0)}</div></div>
        <div class="stat"><div class="label">1st win rate <Info text="Win rate when taking the first turn." /></div><div class:list={['value', cls(s.first)]}>{pct(s.first)}</div></div>
        <div class="stat"><div class="label">2nd win rate <Info text="Win rate when taking the second turn. Compare with 1st to decide the coin flip." /></div><div class:list={['value', cls(s.second)]}>{pct(s.second)}</div></div>
        <div class="stat"><div class="label">Raw win rate <Info text="Wins divided by games, unadjusted." /></div><div class:list={['value', cls(s.winRate)]}>{pct(s.winRate)}</div></div>
      </div>
    </div>
  </div>

  <h2>Matchup breakdown <Info text="How this leader fares against each opponent, most-played first. Green favours this leader, red favours the opponent. 1st / 2nd split the same games by who took the first turn." /> <span class="sub"><a href="/matchups/">full matrix →</a></span></h2>
  <div class="panel scroll">
    <table class="breakdown">
      <thead><tr><th>Leader</th>{opps.map((o) => <th><LeaderArt code={o.code} size="md" label={false} /></th>)}</tr></thead>
      <tbody>
        <tr><th>Win rate</th>{opps.map((o) => <td class={cls(o.m.winRate)} style={`background:${heat(o.m.winRate)}`}>{pct(o.m.winRate)}</td>)}</tr>
        <tr><th>Games</th>{opps.map((o) => <td class="muted">{fmt(o.m.games, 0)}</td>)}</tr>
        <tr><th>1st</th>{opps.map((o) => <td class={cls(o.m.first)}>{pct(o.m.first)}</td>)}</tr>
        <tr><th>2nd</th>{opps.map((o) => <td class={cls(o.m.second)}>{pct(o.m.second)}</td>)}</tr>
      </tbody>
    </table>
  </div>

  {cardsF.openingHand.length > 0 && <>
    <h2>Starting hand analysis <Info text="How often each card is in the opening five after mulligans, across all games with this leader last week." /></h2>
    <div class="panel"><div class="hand-row">{cardsF.openingHand.slice(0, 12).map((c) => (
      <div class="hand-card" title={card(c.id).name}><img src={imgUrl(c.id)} alt={card(c.id).name} loading="lazy" onerror={imgOnError(c.id)} /><div class="num" style="text-align:center;font-weight:600">{pct(c.rate)}</div></div>
    ))}</div></div></>}

  <div class="grid two">
    <section>
      <h2>Decklists <span class="sub">{decks.decks.length} lists · top {Math.min(SHOW, decks.decks.length)} by games</span> <Info text="Distinct 50-card lists seen in ranked last week. Games and win rate combine every ranked game we have for the exact list. Expand a list to see the cards." /></h2>
      <p class="muted small" style="margin:-.4rem 0 .6rem">Click a list to expand it and see all 50 cards. Differences are measured against the #1 list.</p>
      {decks.decks.slice(0, SHOW).map((d, i) => <DeckCard deck={d} leader={L.code} open={i === 0} rank={i + 1} baseline={decks.decks[0]} />)}
    </section>
    <section>
      <h2>Top pilots <Info text="Top-1,000 ladder players with this leader among their most-played, by bounty." /></h2>
      <div class="panel tight">
        <table>
          <thead><tr><th>Player</th><th class="num">Bounty</th><th class="num">With this leader</th></tr></thead>
          <tbody>{topPilotsOnLadder.map((p) => { const t = p.topLeaders.find((t) => t.code === L.code)!; return (
            <tr><td><span class="pill-rank" style="min-width:1.9rem;height:1.9rem;font-size:.8rem;margin-right:.5rem">{p.rank}</span><a href={`/players/${p.id}/`} style="font-weight:600;color:var(--text)">{p.name}</a></td><td class="num gold" style="font-weight:700">{berry(p.bounty)}</td>
              <td class:list={['num', cls(t.winRate)]}>{pct(t.winRate)} <span class="muted small">/ {t.matches}</span></td></tr>); })}</tbody>
        </table>
        {decks.topPilots.length > 0 && <>
          <table style="margin-top:.25rem"><thead><tr><th>Best pilots last week <Info text="Ranked by weighted win rate with this leader over the last week, any bounty." /></th><th class="num">Games</th><th class="num">Win %</th></tr></thead>
          <tbody>{decks.topPilots.map((p) => <tr><td><span class="muted small" style="margin-right:.4rem">#{p.rank}</span>{p.name}</td><td class="num muted">{p.games}</td><td class:list={['num', cls(p.winRate)]}>{pct(p.winRate)}</td></tr>)}</tbody></table></>}
      </div>

      <h2>Card usage <span class="sub">{fmt(cardsF.leaderStats?.uniqueDecklists, 0)} lists</span> <Info text="Per card across every ranked list for this leader last week. Usage is the share of lists running it; copies is the average count when included; vs leader is the win rate of lists with the card minus the leader's overall win rate." /></h2>
      <div class="panel scroll" style="max-height:720px">
        <table>
          <thead><tr><th>Card</th><th class="num">Usage</th><th class="num">Copies</th><th class="num">Win %</th><th class="num">vs leader</th></tr></thead>
          <tbody>{cardsF.cards.slice(0, 60).map((c) => { const k2 = card(c.id); return (
            <tr><td style="display:flex;align-items:center;gap:.6rem"><img src={imgUrl(c.id)} alt="" loading="lazy" onerror={imgOnError(c.id)} style="width:44px;height:62px;object-fit:cover;object-position:top;border-radius:5px;flex:none" /><span><span style="font-weight:500">{k2.name}</span><div class="muted small">{k2.type?.toLowerCase()}{k2.cost && ` · cost ${k2.cost}`}</div></span></td>
              <td class="num"><div class="bar" style="width:56px;display:inline-block;vertical-align:middle;margin-right:.4rem"><i style={`width:${c.usage}%`}></i></div>{pct(c.usage)}</td>
              <td class="num">{fmt(c.avgCopies, 1)}</td>
              <td class:list={['num', cls(c.winRate)]}>{pct(c.winRate)}</td>
              <td class:list={['num', (c.winRateVsLeader ?? 0) >= 0 ? 'good' : 'bad']}>{c.winRateVsLeader == null ? '–' : `${c.winRateVsLeader >= 0 ? '+' : ''}${fmt(c.winRateVsLeader, 2)}`}</td></tr>); })}</tbody>
        </table>
      </div>

      {techOpps.length > 0 && <>
        <h2>Tech cards by matchup <Info text="Cards that raise this leader's win rate in a specific matchup. The number is the lift in percentage points; only cards with strong statistical evidence are shown." /></h2>
        <div class="panel">
          {techOpps.map(([opp, techs]) => (
            <div style="display:flex;gap:.9rem;align-items:center;padding:.5rem 0;border-bottom:1px solid var(--line)">
              <LeaderArt code={opp} size="sm" label={false} />
              <div style="font-size:.85rem;display:flex;flex-wrap:wrap;gap:.3rem">{techs.map((t) => <span class="chip" title={`${pct(t.winRateWith)} with vs ${pct(t.winRateWithout)} without · ${t.gamesWith} games`}>{card(t.id).name} <b class="good">+{fmt(t.lift)}</b></span>)}</div>
            </div>
          ))}
        </div></>}
    </section>
  </div>
</Base>
