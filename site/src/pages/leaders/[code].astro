---
import Base from '../../layouts/Base.astro';
import LeaderDetail from '../../components/LeaderDetail.astro';
import { leadersByVolumeFor, type Leader } from '../../lib/data';
export function getStaticPaths() {
  return leadersByVolumeFor('7d').map((l) => ({ params: { code: l.code }, props: { leader: l } }));
}
const { leader } = Astro.props as { leader: Leader };
---
<Base title={`${leader.name} [${leader.code}]`} wide><LeaderDetail window="7d" leader={leader} /></Base>
